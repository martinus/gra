# ---------------------------------------------------------------------------
# Process and output helpers
# ---------------------------------------------------------------------------


def expand_path(path: str) -> Path:
    return Path(os.path.expandvars(os.path.expanduser(path)))


def log(msg: str, color: str = BLUE) -> None:
    if not _quiet:
        print(f"{color}{msg}{ENDC}")


def style(text: str, *colors: str) -> str:
    code = "".join(colors)
    return f"{code}{text}{ENDC}" if code else text


def fail(msg: str) -> NoReturn:
    print(f"{RED}ERROR: {msg}{ENDC}", file=sys.stderr)
    sys.exit(1)


def ask_yes_no(question: str) -> bool:
    print(f"{question} [y/N] ", end="", file=sys.stderr, flush=True)
    answer = sys.stdin.readline()
    if not answer:
        print(file=sys.stderr)
        return False
    return answer.strip().lower() in {"y", "yes"}


def run_git(args: list[str | Path], *, cwd: Path | None = None) -> None:
    """Run a Git command that should own its normal terminal output."""
    subprocess.run(["git", *args], cwd=cwd, check=True)


def command_output(args: list[str | Path], *, cwd: Path | None = None) -> str | None:
    """Run a command quietly; return its output, or None when it fails."""
    try:
        return subprocess.check_output(
            args, cwd=cwd, encoding="utf-8", stderr=subprocess.DEVNULL
        ).strip()
    except subprocess.CalledProcessError:
        return None


def git_output(args: list[str | Path], *, cwd: Path | None = None) -> str | None:
    """Run Git quietly; return its output, or None when the command fails."""
    return command_output(["git", *args], cwd=cwd)


T = TypeVar("T")
U = TypeVar("U")


def parallel_map(fn: Callable[[T], U], items: list[T]) -> list[U]:
    """Map fn over items with a bounded thread pool, preserving order."""
    if len(items) <= 1:
        return [fn(item) for item in items]
    with ThreadPoolExecutor(max_workers=min(8, len(items))) as executor:
        return list(executor.map(fn, items))


# ---------------------------------------------------------------------------
# Remote URL and local name helpers
# ---------------------------------------------------------------------------


SCP_LIKE_URL = re.compile(r"[^@/]+@([^:]+):(.+)$")


class RepoUrl(NamedTuple):
    """A git URL classified once: remote flag, host, owner segment, repo name."""

    remote: bool
    host: str | None
    owner: str | None
    repo: str | None

    def owning_account(self) -> str | None:
        """The owner when it identifies the repository.

        A local path has an enclosing directory, not an owner: it says where
        that machine keeps its clones, so it neither disambiguates a name nor
        means anything on another machine.
        """
        return self.owner if self.remote else None


def parse_repo_url(url: str) -> RepoUrl:
    """Classify a git URL (HTTPS, SSH scp-like, or local path) in one pass."""
    if match := SCP_LIKE_URL.match(url):
        remote, host, path = True, match.group(1), match.group(2)
    else:
        parsed = urlparse(url)
        remote, host = bool(parsed.scheme), parsed.hostname
        path = parsed.path if parsed.scheme else url
    parts = [part for part in path.rstrip("/").removesuffix(".git").split("/") if part]
    owner = parts[-2] if len(parts) >= 2 else None
    return RepoUrl(remote, host, owner, parts[-1] if parts else None)


def repo_name_from_url(url: str) -> str:
    """Derive the local repository name: the last path component of the URL."""
    repo = parse_repo_url(url).repo
    if repo is None:
        raise ValueError(f"cannot derive repository name from '{url}'")
    return repo


def suggest_clone_name(url: str, repo_name: str) -> str:
    """Suggest a distinct name for a colliding clone.

    Remote URLs disambiguate by owner (the common case: two owners with the
    same repository name); anything else falls back to a numeric suffix.
    """
    owner = parse_repo_url(url).owning_account()
    if owner and owner != repo_name:
        return f"{repo_name}-{owner}"
    return f"{repo_name}-2"


def validate_path_name(kind: str, name: str) -> None:
    if not VALID_PATH_NAME.fullmatch(name):
        fail(
            f"invalid {kind} name '{name}'; use only letters, numbers, dots, underscores, and dashes"
        )
    if name in {".", ".."} or name.startswith("."):
        fail(f"invalid {kind} name '{name}'")


def origin_url(bare: Path) -> str | None:
    return git_output(["config", "--get", "remote.origin.url"], cwd=bare)


def fork_parent_url(url: str) -> str | None:
    """The repository a GitHub fork was made from, or None if it is not one."""
    parsed = parse_repo_url(url)
    if parsed.host != GITHUB_HOST or not parsed.owner or not parsed.repo:
        return None
    if not shutil.which("gh"):
        log(f"gh is not installed; not looking for a fork parent of '{url}'")
        return None
    # Match origin's protocol, so upstream authenticates the same way.
    field = "clone_url" if url.startswith(("http://", "https://")) else "ssh_url"
    parent = command_output(
        ["gh", "api", f"repos/{parsed.owner}/{parsed.repo}", "--jq", f".parent.{field}"]
    )
    if parent is None:
        log(f"could not ask gh whether '{url}' is a fork", YELLOW)
        return None
    return parent or None


def add_upstream_remote(bare: Path, url: str) -> None:
    """Point 'upstream' at the repository this one was forked from."""
    if git_output(["config", "--get", "--type=bool", UPSTREAM_CONFIG], cwd=bare) == "false":
        return
    parent = fork_parent_url(url)
    if not parent:
        return
    run_git(["remote", "add", UPSTREAM_REMOTE, parent], cwd=bare)
    log(
        f"added remote '{UPSTREAM_REMOTE}' -> {parent}; "
        f"run 'git fetch {UPSTREAM_REMOTE}' for its branches",
        GREEN,
    )


def clone_collision_error(url: str, container: Path, local_name: str) -> None:
    lines = [
        f"local repository name '{local_name}' already exists",
        "",
        "Existing:",
        f"  path:   {container}",
    ]
    if origin := origin_url(container / BARE_DIR):
        lines.append(f"  origin: {origin}")
    lines += [
        "",
        "Requested:",
        f"  origin: {url}",
        "",
        "Use a distinct name, for example:",
        f"  gra clone {url} --name {suggest_clone_name(url, local_name)}",
    ]
    fail("\n".join(lines))


# ---------------------------------------------------------------------------
# gra layout discovery
# ---------------------------------------------------------------------------


def branch_name_from_input(ref: str) -> str:
    """Derive a Git-friendly branch name from user input."""
    name = re.sub(r"[^A-Za-z0-9._/-]+", "-", ref.strip())
    name = re.sub(r"-+", "-", name)
    name = re.sub(r"/+", "/", name).strip("-/.")
    name = re.sub(r"\.\.+", "-", name)
    parts = [part.strip("-.") for part in name.split("/")]
    name = "/".join(part for part in parts if part)
    if not name or name in {"@", ".", ".."}:
        fail(f"cannot derive branch name from '{ref}'")
    if any(part.endswith(".lock") for part in name.split("/")):
        fail(f"cannot derive branch name from '{ref}'")
    return name


def is_container(path: Path) -> bool:
    return (path / BARE_DIR).is_dir()


def bare_dir(container: Path) -> Path:
    return container / BARE_DIR


def containers(root: Path) -> list[Path]:
    if not root.is_dir():
        return []
    return sorted(
        (child for child in root.iterdir() if child.is_dir() and is_container(child)),
        key=lambda path: path.name,
    )


def find_container(path: Path) -> Path | None:
    """Walk upward looking for a gra repo container."""
    for candidate in [path, *path.parents]:
        if is_container(candidate):
            return candidate
    return None


def git_toplevel(path: Path) -> Path | None:
    """Return the enclosing Git worktree root, if path is inside one."""
    toplevel = git_output(["rev-parse", "--show-toplevel"], cwd=path)
    return Path(toplevel) if toplevel else None


def gra_location() -> tuple[Path | None, Path | None]:
    """Resolve (container, worktree) for the current directory, leniently.

    The worktree is None in the repository folder, and both are None outside
    gra entirely - so callers can behave differently in each place instead of
    demanding one of them.
    """
    toplevel = git_toplevel(Path.cwd())
    if toplevel and toplevel.name != BARE_DIR and is_container(toplevel.parent):
        return toplevel.parent, toplevel
    return find_container(Path.cwd()), None


def current_gra_worktree(command: str) -> tuple[Path, Path]:
    """Resolve (container, worktree) for the current directory, or fail."""
    container, worktree = gra_location()
    if container is None or worktree is None:
        fail(f"gra {command} must be run from inside a gra worktree")
    return container, worktree


# ---------------------------------------------------------------------------
# Git branch and worktree probes
# ---------------------------------------------------------------------------


def local_branch_exists(bare: Path, branch: str) -> bool:
    return (
        git_output(["show-ref", "--verify", "--quiet", f"refs/heads/{branch}"], cwd=bare)
        is not None
    )


def remote_branch_exists(bare: Path, branch: str) -> bool:
    return (
        git_output(
            ["show-ref", "--verify", "--quiet", f"refs/remotes/origin/{branch}"],
            cwd=bare,
        )
        is not None
    )


def origin_head_ref(path: Path) -> str | None:
    """Resolve origin/HEAD to its branch name, for example 'origin/main'."""
    return git_output(
        ["symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD"], cwd=path
    )


def remote_default_branch(bare: Path) -> str | None:
    origin_head = origin_head_ref(bare)
    if origin_head and git_output(
        ["rev-parse", "--verify", "--quiet", f"{origin_head}^{{commit}}"], cwd=bare
    ):
        return origin_head

    for branch in ["main", "master"]:
        if remote_branch_exists(bare, branch):
            return f"origin/{branch}"

    return None


def worktree_entries(bare: Path) -> list[tuple[Path, str | None]]:
    """Parse (path, branch) for each registered worktree, bare one excluded.

    One place understands the porcelain format; worktree_paths and
    worktree_branches are views on it.
    """
    output = git_output(["worktree", "list", "--porcelain"], cwd=bare) or ""
    entries: list[tuple[Path, str | None]] = []
    for line in output.splitlines():
        if line.startswith("worktree "):
            entries.append((Path(line.removeprefix("worktree ")), None))
        elif line == "bare":
            entries.pop()
        elif line.startswith("branch ") and entries:
            path, _ = entries[-1]
            entries[-1] = (path, line.removeprefix("branch ").removeprefix("refs/heads/"))
    return entries


def worktree_paths(bare: Path) -> list[Path]:
    """Return registered worktree paths, excluding the bare repository itself."""
    return [path for path, _branch in worktree_entries(bare)]


def worktree_branches(bare: Path) -> dict[str, Path]:
    """Map each checked-out branch to the worktree holding it.

    Git allows a branch in only one worktree at a time, and the porcelain
    listing already says which, so nothing needs asking worktree by worktree.
    """
    return {branch: path for path, branch in worktree_entries(bare) if branch}


def refuse_if_branch_is_checked_out(bare: Path, branch: str, current: Path | None = None) -> None:
    """Point at the worktree already holding a branch, instead of letting Git fail.

    Git's own message names neither the worktree nor a way forward, and this
    is easy to hit: 'gra clone' checks out the default branch, so asking for
    it again by name is a natural next move.
    """
    holder = worktree_branches(bare).get(branch)
    if holder is None or holder == current:
        return
    fail(
        f"'{branch}' is already checked out in '{holder.name}'; "
        f"work there with 'gra cd {holder.name}'"
    )


def worktree_ref(path: Path) -> str:
    if not path.exists():
        return "missing"

    branch = git_output(["branch", "--show-current"], cwd=path)
    if branch:
        return branch

    exact = git_output(["describe", "--all", "--exact-match", "HEAD"], cwd=path)
    if exact:
        ref = exact.removeprefix("heads/").removeprefix("remotes/")
        if ref == "origin/HEAD":
            ref = origin_head_ref(path) or ref
        return ref

    short_head = git_output(["rev-parse", "--short", "HEAD"], cwd=path)
    return short_head or "detached"


def worktree_sync(path: Path) -> str:
    """How far a worktree's branch is from its upstream, as of the last fetch.

    Reads local refs only: 'gra ls' stays offline, so this is as fresh as
    whatever last fetched. Empty means in sync; '-' means the question does
    not apply - detached, or a branch with no upstream.
    """
    # A registered worktree whose directory is gone would make git fail to
    # start at all, which is not a failure git_output can catch.
    if not path.exists():
        return "-"
    counts = git_output(
        ["rev-list", "--left-right", "--count", "@{upstream}...HEAD"], cwd=path
    )
    if not counts:
        return "-"
    behind, ahead = counts.split()
    parts = []
    if ahead != "0":
        parts.append(f"↑{ahead}")
    if behind != "0":
        parts.append(f"↓{behind}")
    return " ".join(parts)


def worktree_status_output(path: Path) -> str:
    return git_output(["status", "--porcelain"], cwd=path) or ""


def fmt_worktree_status(path: Path, status_output: str | None = None) -> str:
    if not path.exists():
        return "× missing"
    if status_output is None:
        status_output = worktree_status_output(path)
    return "● dirty" if status_output else "✓ clean"


# ---------------------------------------------------------------------------
# Worktree name picking
# ---------------------------------------------------------------------------


def taken_worktree_names(root: Path) -> set[str]:
    """Collect worktree names in use anywhere under the gra root."""
    names: set[str] = set()
    repositories = containers(root)
    for container in repositories:
        for child in container.iterdir():
            if child.name != BARE_DIR and child.is_dir():
                names.add(child.name)
    for paths in parallel_map(lambda c: worktree_paths(bare_dir(c)), repositories):
        names.update(path.name for path in paths)
    return names


def worktree_identity(container: Path) -> str:
    """The string a repository's worktree names are derived from.

    Normalized to 'owner/repo' so that a machine cloning over SSH and one
    cloning over HTTPS derive the same names.
    """
    url = origin_url(bare_dir(container))
    if not url:
        return container.name
    parsed = parse_repo_url(url)
    if not parsed.repo:
        return container.name
    owner = parsed.owning_account()
    return f"{owner}/{parsed.repo}" if owner else parsed.repo


def _shuffled(words: tuple[str, ...], identity: str, domain: str) -> list[str]:
    """The word list in an order private to this repository.

    SHA-256 rather than hash(), which is randomized per process for strings
    and so would not even be stable between two runs on one machine. The
    domain decorrelates the two lists' orders.
    """
    return sorted(words, key=lambda word: hashlib.sha256(f"{domain}:{identity}#{word}".encode()).digest())


def name_candidates(identity: str) -> list[str]:
    """The repository's preference order over every name, best first.

    Descriptors and nouns are paired as a Latin square: both positions advance
    together, so consecutive names share neither word, and every combination
    appears exactly once before the list ends - it can neither repeat itself
    nor run out.
    """
    descriptors = _shuffled(DESCRIPTORS, identity, "descriptor")
    nouns = _shuffled(NOUNS, identity, "noun")
    return [
        descriptor + nouns[(column + row) % len(nouns)]
        for row in range(len(nouns))
        for column, descriptor in enumerate(descriptors)
    ]


def pick_worktree_name(root: Path, identity: str) -> str:
    """Pick the repository's first name that no worktree anywhere is using.

    Every pick starts at the front of the list, so a repository's k-th
    worktree lands on its k-th name without any counter being stored, and a
    name freed by 'gra done' is reclaimed by the next 'gra work'.
    """
    taken = taken_worktree_names(root)
    for word in name_candidates(identity):
        if word not in taken:
            return word
    fail("all worktree names are taken; run 'gra clean' or 'gra done' first")


