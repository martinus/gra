# gra layout discovery
# ---------------------------------------------------------------------------


def branch_name_from_input(ref: str) -> str:
    """Derive a Git-friendly branch name from user input."""
    name = re.sub(r"[^A-Za-z0-9._/-]+", "-", ref.strip())
    name = re.sub(r"-+", "-", name)
    name = re.sub(r"/+", "/", name).strip("-/.")
    name = re.sub(r"\.\.+", "-", name)
    parts = [part.strip("-.") for part in name.split("/")]
    name = "/".join(part for part in parts if part)
    if not name or name in {"@", ".", ".."}:
        fail(f"cannot derive branch name from '{ref}'")
    if any(part.endswith(".lock") for part in name.split("/")):
        fail(f"cannot derive branch name from '{ref}'")
    return name


def is_container(path: Path) -> bool:
    return (path / BARE_DIR).is_dir()


def bare_dir(container: Path) -> Path:
    return container / BARE_DIR


def containers(root: Path) -> list[Path]:
    if not root.is_dir():
        return []
    return sorted(
        (child for child in root.iterdir() if child.is_dir() and is_container(child)),
        key=lambda path: path.name,
    )


def find_container(path: Path) -> Path | None:
    """Walk upward looking for a gra repo container."""
    for candidate in [path, *path.parents]:
        if is_container(candidate):
            return candidate
    return None


def git_toplevel(path: Path) -> Path | None:
    """Return the enclosing Git worktree root, if path is inside one."""
    toplevel = git_output(["rev-parse", "--show-toplevel"], cwd=path)
    return Path(toplevel) if toplevel else None


def current_gra_worktree(command: str) -> tuple[Path, Path]:
    """Resolve (container, worktree) for the current directory."""
    worktree = git_toplevel(Path.cwd())
    if not worktree:
        fail(f"gra {command} must be run from inside a gra worktree")
    container = worktree.parent
    if not is_container(container) or worktree.name == BARE_DIR:
        fail(f"'{worktree}' is not a gra worktree; gra {command} must be run inside one")
    return container, worktree


# ---------------------------------------------------------------------------
# Git branch and worktree probes
# ---------------------------------------------------------------------------


def local_branch_exists(bare: Path, branch: str) -> bool:
    return (
        git_output(["show-ref", "--verify", "--quiet", f"refs/heads/{branch}"], cwd=bare)
        is not None
    )


def remote_branch_exists(bare: Path, branch: str) -> bool:
    return (
        git_output(
            ["show-ref", "--verify", "--quiet", f"refs/remotes/origin/{branch}"],
            cwd=bare,
        )
        is not None
    )


def origin_head_ref(path: Path) -> str | None:
    """Resolve origin/HEAD to its branch name, for example 'origin/main'."""
    return git_output(
        ["symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD"], cwd=path
    )


def remote_default_branch(bare: Path) -> str | None:
    origin_head = origin_head_ref(bare)
    if origin_head and git_output(
        ["rev-parse", "--verify", "--quiet", f"{origin_head}^{{commit}}"], cwd=bare
    ):
        return origin_head

    for branch in ["main", "master"]:
        if remote_branch_exists(bare, branch):
            return f"origin/{branch}"

    return None


def worktree_paths(bare: Path) -> list[Path]:
    """Return registered worktree paths, excluding the bare repository itself."""
    output = git_output(["worktree", "list", "--porcelain"], cwd=bare) or ""
    paths: list[Path] = []
    for line in output.splitlines():
        if line.startswith("worktree "):
            paths.append(Path(line.removeprefix("worktree ")))
        elif line == "bare":
            paths.pop()
    return paths


def worktree_ref(path: Path) -> str:
    if not path.exists():
        return "missing"

    branch = git_output(["branch", "--show-current"], cwd=path)
    if branch:
        return branch

    exact = git_output(["describe", "--all", "--exact-match", "HEAD"], cwd=path)
    if exact:
        ref = exact.removeprefix("heads/").removeprefix("remotes/")
        if ref == "origin/HEAD":
            ref = origin_head_ref(path) or ref
        return ref

    short_head = git_output(["rev-parse", "--short", "HEAD"], cwd=path)
    return short_head or "detached"


def worktree_status_output(path: Path) -> str:
    return git_output(["status", "--porcelain"], cwd=path) or ""


def fmt_worktree_status(path: Path, status_output: str | None = None) -> str:
    if not path.exists():
        return "× missing"
    if status_output is None:
        status_output = worktree_status_output(path)
    return "● dirty" if status_output else "✓ clean"


# ---------------------------------------------------------------------------
# Worktree name picking
# ---------------------------------------------------------------------------


def taken_worktree_names(root: Path) -> set[str]:
    """Collect worktree names in use anywhere under the gra root."""
    names: set[str] = set()
    repositories = containers(root)
    for container in repositories:
        for child in container.iterdir():
            if child.name != BARE_DIR and child.is_dir():
                names.add(child.name)
    for paths in parallel_map(lambda c: worktree_paths(bare_dir(c)), repositories):
        names.update(path.name for path in paths)
    return names


def pick_worktree_name(root: Path) -> str:
    available = sorted(set(WORDS) - taken_worktree_names(root))
    if not available:
        fail("all worktree names are taken; run 'gra clean' or 'gra done' first")
    return random.choice(available)


# ---------------------------------------------------------------------------
# Table output helpers
# ---------------------------------------------------------------------------


def column_widths(
    headers: list[str], rows: list[list[str]], *, include_headers: bool = True
) -> list[int]:
    widths = [len(header) if include_headers else 0 for header in headers]
    for row in rows:
        for index, value in enumerate(row):
            widths[index] = max(widths[index], len(value))
    return widths


def padded_line(values: list[str], widths: list[int]) -> str:
    return "  ".join(value.ljust(width) for value, width in zip(values, widths)).rstrip()


def table_cell(header: str, value: str) -> str:
    if not value:
        return value
    if not header:
        return style(value, BLUE, BOLD)
    if header == "REPOSITORY":
        return style(value, BLUE, BOLD)
    if header == "BRANCH":
        return style(value, CYAN)
    if header == "REMOTE":
        return style(value, DIM)
    if header == "STATUS":
        if value.startswith("✓"):
            return style(value, GREEN)
        if value.startswith("●"):
            return style(value, YELLOW)
        if value.startswith("×"):
            return style(value, RED)
    if header == "VERDICT":
        if value == "remove":
            return style(value, GREEN)
        if value == "prune":
            return style(value, YELLOW)
        if value == "keep":
            return style(value, DIM)
    return value


def table_line(headers: list[str], values: list[str], widths: list[int]) -> str:
    cells = []
    for header, value, width in zip(headers, values, widths):
        cells.append(table_cell(header, value) + " " * (width - len(value)))
    return "  ".join(cells).rstrip()


def print_table(headers: list[str], rows: list[list[str]], *, indent: str = "") -> None:
    columns = [i for i, h in enumerate(headers) if h or any(row[i] for row in rows)]
    headers = [headers[i] for i in columns]
    rows = [[row[i] for i in columns] for row in rows]

    widths = column_widths(headers, rows)

    print(indent + style(table_line(headers, headers, widths), BOLD))
    for row in rows:
        print(indent + table_line(headers, row, widths))


# ---------------------------------------------------------------------------
# clone command
# ---------------------------------------------------------------------------


def add_local_excludes(bare: Path) -> None:
    """Install ignore rules for tool-managed paths, shared by all worktrees."""
    info = bare / "info"
    exclude = info / "exclude"
    info.mkdir(exist_ok=True)
    lines = exclude.read_text(encoding="utf-8").splitlines() if exclude.is_file() else []
    missing = [pattern for pattern in LOCAL_EXCLUDES if pattern not in lines]
    if missing:
        with exclude.open("a", encoding="utf-8") as file:
            if lines and lines[-1] != "":
                file.write("\n")
            for pattern in missing:
                file.write(f"{pattern}\n")


def write_setup_sample(container: Path) -> None:
    """Drop a commented, non-executable sample .tmux-setup in the container."""
    script = container / SETUP_FILE
    if not script.exists():
        script.write_text(SETUP_SAMPLE, encoding="utf-8")


def clone(url: str, name: str | None, root: Path) -> None:
    """Clone a repository into a bare checkout under the gra root."""
    try:
        local_name = name or repo_name_from_url(url)
    except ValueError as error:
        fail(str(error))
    validate_path_name("repository", local_name)

    container = root / local_name
    if container.exists():
        clone_collision_error(url, container, local_name)

    bare = bare_dir(container)
    try:
        bare.mkdir(parents=True)
        log(f"Cloning '{url}' into '{container}'")
        run_git(["init", "--quiet", "--bare", bare])
        # `git remote add` installs the standard +refs/heads/*:refs/remotes/origin/*
        # refspec, so the bare repository tracks origin like a normal clone and
        # never mirrors remote branches into local refs/heads.
        run_git(["remote", "add", "origin", url], cwd=bare)
        # Bare repositories disable reflogs by default; keep them for safety.
        run_git(["config", "core.logAllRefUpdates", "true"], cwd=bare)
        run_git(["fetch", "--prune", "origin"], cwd=bare)
        run_git(["remote", "set-head", "origin", "--auto"], cwd=bare)
        add_local_excludes(bare)
        write_setup_sample(container)
        log(f"created '{container}'; run 'gra work' inside it to begin working", GREEN)
    except Exception:
        if container.exists():
            shutil.rmtree(container)
        raise


