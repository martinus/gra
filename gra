# Picker helpers (cd, work)
# ---------------------------------------------------------------------------


def fzf_table(
    command: str, headers: list[str], entries: list[tuple[str, list[str]]]
) -> str:
    """Select from (key, columns) entries with fzf and return the chosen key.

    Owns the whole table convention - aligned columns behind a hidden key -
    so every picker lays out and selects the same way. A cancelled fzf exits
    this process with fzf's own status, so callers only ever see a selection
    that was actually made.
    """
    if not shutil.which("fzf"):
        fail(f"fzf is required for '{command}'")

    widths = column_widths(
        headers, [cells for _key, cells in entries], include_headers=False
    )
    choices = [f"{key}\t{padded_line(cells, widths)}" for key, cells in entries]
    header = padded_line(headers, widths)

    result = subprocess.run(
        [
            "fzf",
            "--height=80%",
            "--layout=reverse",
            "--border",
            "--tiebreak=begin,index",
            f"--prompt={command}> ",
            f"--header={header}",
            "--delimiter=\t",
            "--with-nth=2",
        ],
        input="\n".join(choices) + "\n",
        stdout=subprocess.PIPE,
        encoding="utf-8",
        check=False,
    )
    if result.returncode != 0:
        sys.exit(result.returncode)

    selected = result.stdout.rstrip("\n")
    if not selected:
        sys.exit(1)
    return selected.split("\t", 1)[0]


class WorktreeRow(NamedTuple):
    """One worktree in pickers and machine-readable listings."""

    path: str
    repo: str
    word: str
    ref: str

    def values(self) -> list[str]:
        return [self.repo, self.word, self.ref]


def local_worktree_picker_rows(root: Path) -> list[WorktreeRow]:
    """Return local worktree picker rows under the gra root."""
    entries = [
        (container.name, path)
        for container in containers(root)
        for path in worktree_paths(bare_dir(container))
        if path.is_dir()
    ]
    refs = parallel_map(lambda entry: worktree_ref(entry[1]), entries)
    return [
        WorktreeRow(str(path), repo, path.name, ref)
        for (repo, path), ref in zip(entries, refs)
    ]


PICKER_HEADERS = ["REPOSITORY", "WORKTREE", "BRANCH"]


def select_worktree_row_from_rows(rows: list[WorktreeRow], source: str) -> WorktreeRow:
    """Select a worktree with fzf and return its picker row."""
    if not rows:
        fail(f"no worktrees found {source}")
    target = fzf_table("gra cd", PICKER_HEADERS, [(row.path, row.values()) for row in rows])
    for row in rows:
        if row.path == target:
            return row
    fail(f"invalid worktree selection '{target}'")


def find_worktree_path(root: Path, name: str) -> Path | None:
    """The worktree directory called name, or None when there is no such name.

    Names are unique across all repositories and worktrees always live directly
    under their container, so a filesystem probe finds the worktree without
    querying Git in every repository.
    """
    if name == BARE_DIR:
        return None
    for container in containers(root):
        path = container / name
        if path.is_dir():
            return path
    return None


def resolve_worktree_name(root: Path, name: str) -> WorktreeRow:
    """Resolve a worktree name like 'snowwolf' to its row."""
    path = find_worktree_path(root, name)
    if path is None:
        fail(f"no worktree named '{name}' under '{root}'")
    return WorktreeRow(str(path), path.parent.name, name, worktree_ref(path))


def pick_worktree_row(root: Path, name: str | None = None) -> WorktreeRow:
    """Resolve a worktree by name, or select one with fzf."""
    if name:
        return resolve_worktree_name(root, name)
    return select_worktree_row_from_rows(
        local_worktree_picker_rows(root), f"under '{root}'"
    )


def print_cd_target(root: Path, name: str | None) -> None:
    """Print the path of a worktree chosen by name or with fzf."""
    print(pick_worktree_row(root, name).path)


# ---------------------------------------------------------------------------
# tmux windows
# ---------------------------------------------------------------------------

# A worktree gets one tmux window, named '<repo>/<word>', opened whenever gra
# leaves you in the worktree and closed again when 'gra done' removes it. The
# name is how the two find each other, and it is the only state gra keeps
# about a window - there is no file to configure and nothing to install.


def tmux_window_name(worktree: Path) -> str:
    """The window name for a worktree, e.g. 'oans/warmhare'."""
    return f"{worktree.parent.name}/{worktree.name}"


def tmux(args: list[str]) -> str | None:
    """Run tmux and return its output, or None when it is not there or fails.

    tmux does not have to be installed, and a command can fail because the
    window it names just went away, so nothing here is worth failing gra over.
    """
    try:
        result = subprocess.run(
            ["tmux", *args], capture_output=True, text=True, check=False
        )
    except OSError:
        return None
    return result.stdout if result.returncode == 0 else None


def find_tmux_window(name: str) -> str | None:
    """The id of the window called name, in whichever session it is in.

    Every session, not just the current one, because a window outlives the
    session it was opened in and 'gra done' also runs from a plain terminal.
    """
    output = tmux(["list-windows", "-a", "-F", "#{window_id} #{window_name}"])
    for line in (output or "").splitlines():
        window_id, _, window_name = line.partition(" ")
        if window_name == name:
            return window_id
    return None


def current_tmux_window() -> str | None:
    """The id of the window gra itself is running in, if any."""
    pane = os.environ.get("TMUX_PANE")
    if not pane:
        return None
    output = tmux(["display-message", "-p", "-t", pane, "#{window_id}"])
    return output.strip() if output else None


def open_tmux_window(worktree: Path) -> None:
    """Open the worktree's window, or go to the one that is already open.

    Only from inside tmux: elsewhere there is no session the window would
    belong to. The window survives everything but 'gra done', so a second
    'gra work' has to find it rather than open a second window of the name.
    """
    if not os.environ.get("TMUX"):
        return
    name = tmux_window_name(worktree)
    open_window = find_tmux_window(name)
    if open_window:
        tmux(["select-window", "-t", open_window])
        log(f"switched to tmux window '{name}'")
        return
    if tmux(["new-window", "-n", name, "-c", str(worktree)]) is None:
        return
    log(f"opened tmux window '{name}'")


def close_tmux_window(worktree: Path) -> None:
    """Close the worktree's window, before the worktree is removed.

    Runs outside tmux too, so 'gra done <name>' from a plain terminal closes
    the window as well.
    """
    name = tmux_window_name(worktree)
    window = find_tmux_window(name)
    if not window:
        return
    if window != current_tmux_window():
        tmux(["kill-window", "-t", window])
        log(f"closed tmux window '{name}'")
        return
    # The window gra is standing in: killing it now would take gra down before
    # it removes anything. Hand it to the tmux server, which outlives the
    # window, and let it wait for gra to exit. It closes the window only when
    # the worktree really went away, so a removal that fails keeps it.
    tmux(
        [
            "run-shell",
            "-b",
            f"while kill -0 {os.getpid()} 2>/dev/null; do sleep 0.2; done; "
            f"[ -d {shlex.quote(str(worktree))} ] || tmux kill-window -t {window}",
        ]
    )
    log(f"tmux window '{name}' closes once gra exits")


# ---------------------------------------------------------------------------
# install command
# ---------------------------------------------------------------------------


SOURCE_URL = "https://raw.githubusercontent.com/martinus/gra/main/gra"
INSTALL_DIR = "~/.local/bin"
SHELL_INIT_LINE = 'eval "$(gra shell bash)"'


VERSION_LINE = re.compile(rb'^__version__ = "([^"]+)"', re.MULTILINE)


def local_source() -> bytes | None:
    """This script's own bytes, or None when running from 'python3 -c'."""
    path = globals().get("__file__")
    return Path(path).read_bytes() if path and Path(path).is_file() else None


def download_source() -> bytes | None:
    """The script on main, or None when it cannot be fetched."""
    log(f"downloading {SOURCE_URL}")
    try:
        with urllib.request.urlopen(SOURCE_URL) as response:
            return response.read()
    except OSError as error:
        log(f"cannot download {SOURCE_URL}: {error}", YELLOW)
        return None


def source_version(source: bytes) -> str | None:
    """Read a gra script's version without executing it.

    Deciding whether to trust a download by running it would be backwards, so
    the version is read out of the text.
    """
    match = VERSION_LINE.search(source)
    return match.group(1).decode() if match else None


def version_key(version: str | None) -> tuple[int, ...]:
    """Order dotted versions numerically, so 1.10.0 beats 1.9.0."""
    if not version:
        return ()
    try:
        return tuple(int(part) for part in version.split("."))
    except ValueError:
        return ()


def gra_source(check: bool) -> bytes:
    """Return the newest gra source available, preferring the local one on ties.

    Running from a file - a checkout or an earlier install - copies that file,
    so 'gra install' from a checkout installs the checkout. A newer version on
    main wins, which is how an installed gra upgrades itself. Under
    'python3 -c' there is nothing local, so the download is all there is.
    """
    local = local_source()
    if local is not None and not check:
        return local

    remote = download_source()
    if remote is None:
        if local is None:
            fail("nothing to install")
        log("installing the local version instead", YELLOW)
        return local
    if local is None:
        return remote

    local_version, remote_version = source_version(local), source_version(remote)
    if version_key(remote_version) <= version_key(local_version):
        return local
    log(f"upgrading gra {local_version} -> {remote_version}")
    return remote


def install_script(source: bytes) -> Path:
    """Write a gra script to the install directory and make it executable."""
    target = expand_path(INSTALL_DIR) / "gra"
    try:
        target.parent.mkdir(parents=True, exist_ok=True)
        # Unlink first: an earlier install may have left a symlink here, and
        # writing through it would modify whatever it points at.
        target.unlink(missing_ok=True)
        target.write_bytes(source)
        target.chmod(0o755)
    except OSError as error:
        fail(f"cannot write '{target}': {error}")
    return target


def is_on_path(directory: Path) -> bool:
    entries = os.environ.get("PATH", "").split(os.pathsep)
    return any(entry and expand_path(entry) == directory for entry in entries)


def shell_init_block(directory: Path) -> str:
    """Bash lines that put gra on the PATH and enable the shell integration."""
    lines = ["", "# gra"]
    if not is_on_path(directory):
        lines.append(f'export PATH="{INSTALL_DIR.replace("~", "$HOME")}:$PATH"')
    lines.append(SHELL_INIT_LINE)
    return "\n".join(lines) + "\n"


def install(check: bool = True) -> None:
    source = gra_source(check)
    target = install_script(source)
    # Not necessarily __version__: an upgrade installs bytes other than these.
    log(f"installed gra {source_version(source)} to '{target}'")

    block = shell_init_block(target.parent)
    bashrc = expand_path("~/.bashrc")
    if not bashrc.is_file():
        log(f"no '{bashrc}'; add this to your shell configuration:")
        print(block, end="")
        return
    if SHELL_INIT_LINE in bashrc.read_text():
        log(f"shell integration already in '{bashrc}'")
        return
    try:
        with bashrc.open("a") as handle:
            handle.write(block)
    except OSError as error:
        fail(f"cannot write '{bashrc}': {error}")
    log(f"added shell integration to '{bashrc}'; restart your shell")


# ---------------------------------------------------------------------------
# shell command
# ---------------------------------------------------------------------------


BASH_INIT = r'''gra() {
    case ${1-} in
        cd)
            shift
            local target
            target="$(command gra cd "$@")" || return
            [[ -n $target ]] && builtin cd "$target"
            ;;
        done)
            local dir=$PWD
            command gra "$@" || return
            [[ -d $dir ]] || builtin cd "${dir%/*}"
            ;;
        *)
            command gra "$@"
            ;;
    esac
}
'''


# Completion asks git and the filesystem directly rather than running gra:
# gra takes ~75ms to start, which is a long time to hold down Tab, and every
# answer here is a directory listing or one for-each-ref.
BASH_COMPLETION = r'''_gra_root() {
    local root
    # --path expands ~ and ~user the way git itself does; $HOME is the only
    # variable worth matching expand_path on, and eval is not worth the rest.
    root=$(git config --get --path gra.root 2>/dev/null)
    root=${root:-$HOME/gra}
    root=${root//\$\{HOME\}/$HOME}
    printf '%s\n' "${root//\$HOME/$HOME}"
}

_gra_container() {
    local dir
    # Physical, like the Python: a symlinked cwd must resolve the same way.
    dir=$(pwd -P)
    while [[ -n $dir ]]; do
        [[ -d $dir/.bare ]] && { printf '%s\n' "$dir"; return; }
        dir=${dir%/*}
    done
}

_gra_worktrees() {
    local dir name
    # */*/ skips .bare for us: globs do not match leading dots. The .bare test
    # is what keeps a stray directory under the root from looking like one.
    for dir in "$1"/*/*/; do
        [[ -d $dir && -d ${dir%/*/}/.bare ]] || continue
        name=${dir%/}
        printf '%s\n' "${name##*/}"
    done
}

_gra_branches() {
    git --git-dir="$1/.bare" for-each-ref --format='%(refname:lstrip=2)' \
        refs/heads refs/remotes/origin 2>/dev/null |
        sed -e 's|^origin/||' -e '/^HEAD$/d' | sort -u
}

_gra() {
    local cur=${COMP_WORDS[COMP_CWORD]} cmd=${COMP_WORDS[1]-} container words

    if (( COMP_CWORD == 1 )); then
        COMPREPLY=($(compgen -W 'install clone ls work done cd shell' \
            -- "$cur"))
        return
    fi

    # Flags only once one is being typed, so a lone worktree name still
    # completes on its own rather than sharing a menu with --force.
    if [[ $cur == -* ]]; then
        case $cmd in
            clone) words='--name --no-work --no-tmux --no-submodules --no-upstream' ;;
            done) words='--force' ;;
            ls) words='--fetch' ;;
            install) words='--no-check' ;;
        esac
        COMPREPLY=($(compgen -W "$words" -- "$cur"))
        return
    fi

    case $cmd in
        cd|done)
            words=$(_gra_worktrees "$(_gra_root)")
            ;;
        work)
            # A worktree name works from anywhere; branches need a repository.
            words=$(_gra_worktrees "$(_gra_root)")
            container=$(_gra_container)
            [[ -n $container ]] && words+=$'\n'$(_gra_branches "$container")
            ;;
        shell)
            words='bash'
            ;;
    esac
    COMPREPLY=($(compgen -W "$words" -- "$cur"))
}

complete -F _gra gra
'''


def print_shell_init(shell: str) -> None:
    """Print shell integration code for eval."""
    if shell == "bash":
        print(BASH_INIT, end="")
        print(BASH_COMPLETION, end="")
        return
    fail(f"unsupported shell '{shell}'")


# ---------------------------------------------------------------------------
# Branch resolution for the work command
# ---------------------------------------------------------------------------


def create_missing_branch(bare: Path, branch: str) -> None:
    start_point = remote_default_branch(bare)
    if not start_point:
        fail(f"cannot resolve branch '{branch}' and cannot find origin's default branch")

    if not ask_yes_no(f"Branch '{branch}' does not exist. Create it from '{start_point}'?"):
        fail(f"branch '{branch}' was not created")

    run_git(["branch", branch, start_point], cwd=bare)
    run_git(["push", "--set-upstream", "origin", branch], cwd=bare)
    log(f"created branch '{branch}' from '{start_point}' and tracking 'origin/{branch}'", GREEN)


def branches_matching(bare: Path, text: str) -> list[str]:
    """Branch names containing text, local and on origin, without duplicates."""
    return sorted(
        name for name, _age in recent_branches(bare) if text.lower() in name.lower()
    )


def recent_branches(bare: Path) -> list[tuple[str, str]]:
    """(name, last commit age) for local and origin branches, newest first.

    A branch that exists both locally and on origin appears once, at the
    fresher of the two commits - the order is for a picker, not for sync
    bookkeeping.
    """
    output = git_output(
        [
            "for-each-ref",
            "--sort=-committerdate",
            "--format=%(refname:lstrip=2)\t%(committerdate:relative)",
            "refs/heads",
            "refs/remotes/origin",
        ],
        cwd=bare,
    )
    branches: list[tuple[str, str]] = []
    seen: set[str] = set()
    for line in (output or "").splitlines():
        name, _, age = line.partition("\t")
        name = name.removeprefix("origin/")
        if name and name != "HEAD" and name not in seen:
            seen.add(name)
            branches.append((name, age))
    return branches


BRANCH_PICKER_HEADERS = ["BRANCH", "LAST COMMIT"]


def pick_branch(container: Path, command: str) -> str:
    """Pick a branch with fzf, newest commit first; '' means detached.

    Branches already checked out are left out: Git allows a branch in one
    worktree at a time, so picking one could only end in the refusal that
    points at the holding worktree.
    """
    bare = bare_dir(container)
    checked_out = worktree_branches(bare)
    entries: list[tuple[str, list[str]]] = []
    ref = remote_default_branch(bare)
    if ref:
        entries.append(("", [f"{ref} (detached)", ""]))
    entries += [
        (name, [name, age])
        for name, age in recent_branches(bare)
        if name not in checked_out
    ]
    if not entries:
        fail(
            f"every branch of '{container.name}' is already checked out; "
            "'gra cd' reaches their worktrees"
        )
    return fzf_table(command, BRANCH_PICKER_HEADERS, entries)


def resolve_branch(bare: Path, branch: str) -> str:
    """Map what was typed to a branch, preferring one that already exists.

    An exact branch always wins. Otherwise a single branch containing the text
    is taken, which is what lets a ticket key stand in for the branch someone
    named after it - 'gra work OA-2345' finding 'mla/OA-2345-thing'. Several
    matches are shown rather than guessed between.
    """
    if local_branch_exists(bare, branch) or remote_branch_exists(bare, branch):
        return branch
    matches = branches_matching(bare, branch)
    if len(matches) == 1:
        log(f"'{branch}' matches branch '{matches[0]}'")
        return matches[0]
    if matches:
        listing = "\n  ".join(matches)
        fail(f"'{branch}' matches several branches; name one:\n  {listing}")
    return branch


def branch_needs_tracking(bare: Path, branch: str) -> bool:
    """Ensure branch exists locally or on origin; return True when tracking is needed."""
    if local_branch_exists(bare, branch):
        return False
    if remote_branch_exists(bare, branch):
        return True
    create_missing_branch(bare, branch)
    return False


def add_attached_worktree(bare: Path, target: Path, branch: str) -> None:
    """Create a worktree that checks out branch, tracking origin if needed."""
    if branch_needs_tracking(bare, branch):
        run_git(
            ["worktree", "add", "--track", "-b", branch, target, f"origin/{branch}"],
            cwd=bare,
        )
        return
    run_git(["worktree", "add", target, branch], cwd=bare)


def submodules_wanted(bare: Path) -> bool:
    """Whether this repository's worktrees should get their submodules."""
    # Anything git cannot read as a boolean - unset, or a typo - leaves
    # submodules on: a complete checkout is the safer thing to fall back to.
    return git_output(["config", "--get", "--type=bool", SUBMODULES_CONFIG], cwd=bare) != "false"


def init_submodules(bare: Path, worktree: Path) -> None:
    if not (worktree / ".gitmodules").is_file():
        return
    if not submodules_wanted(bare):
        log(f"skipping submodules ({SUBMODULES_CONFIG} is false)")
        return
    log(f"Initializing submodules in '{worktree}'")
    run_git(["submodule", "update", "--init", "--recursive"], cwd=worktree)


def create_worktree(
    container: Path, root: Path, branch: str, *, no_tmux: bool = False
) -> None:
    """Create a worktree named after the repository next to the bare checkout.

    An empty branch starts the worktree detached at origin's default branch.
    Shared by 'gra clone' and 'gra work', so both produce the same workspace.
    """
    bare = bare_dir(container)
    word = pick_worktree_name(root, worktree_identity(container))
    target = container / word

    if branch:
        refuse_if_branch_is_checked_out(bare, branch)
        log(f"Creating worktree '{target}' for branch '{branch}'")
        add_attached_worktree(bare, target, branch)
    else:
        ref = remote_default_branch(bare)
        if not ref:
            fail("cannot find origin's default branch; pass a branch to 'gra work'")
        log(f"Creating worktree '{target}' detached at '{ref}'")
        run_git(["worktree", "add", "--detach", target, ref], cwd=bare)

    init_submodules(bare, target)
    log(f"created '{target}'", GREEN)

    if not no_tmux:
        open_tmux_window(target)


# ---------------------------------------------------------------------------
# work command
# ---------------------------------------------------------------------------


def work(target: str | None, root: Path) -> None:
    """Work here, whatever that takes: a new worktree, or opening one again.

    A worktree name - 'gra work warmhare' - goes to that worktree's tmux
    window from anywhere, because a name identifies one worktree on the whole
    machine. Anything else is a branch, and then where the command runs
    decides: in the repository folder it creates a worktree, for BRANCH or for
    a branch picked with fzf, and inside a worktree a bare 'gra work' opens
    that worktree's window again.
    """
    if target:
        existing = find_worktree_path(root, target)
        if existing is not None:
            set_up_worktree(existing)
            return

    container, worktree = gra_location()
    if container is None:
        fail(
            "gra work needs a worktree name, or a gra repository to run in:\n"
            "  'gra work WORKTREE' opens that worktree's tmux window\n"
            "  in the repository folder it creates a worktree - 'gra work' picks\n"
            "  the branch with fzf, 'gra work BRANCH' names it\n"
            "'gra ls' lists repositories; 'gra cd' jumps into a worktree"
        )

    if worktree and not target:
        set_up_worktree(worktree)
        return

    if target:
        branch = resolve_branch(bare_dir(container), branch_name_from_input(target))
    else:
        branch = pick_branch(container, "gra work")
    create_worktree(container, root, branch)


def set_up_worktree(worktree: Path) -> None:
    """Set an existing worktree up again - which today means its tmux window.

    Setting a worktree up is not a one-shot event: the window can be closed
    while the worktree lives on. Unlike creating a worktree, this is the whole
    command, so outside tmux it says that it had nothing to do.
    """
    if not os.environ.get("TMUX"):
        log(f"not inside tmux; nothing to set up for '{worktree.name}'", YELLOW)
        return
    open_tmux_window(worktree)


# ---------------------------------------------------------------------------
# Worktree removal
# ---------------------------------------------------------------------------


def is_merged_into(path: Path, ref: str) -> bool:
    """Return True if HEAD at path is reachable from ref."""
    result = subprocess.run(
        ["git", "merge-base", "--is-ancestor", "HEAD", ref],
        cwd=path,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return result.returncode == 0


def has_patch_equivalent_changes_in(path: Path, ref: str) -> bool:
    """Return True if commits unique to HEAD have matching patch IDs in ref."""
    output = git_output(["cherry", ref, "HEAD"], cwd=path)
    if output is None:
        return False
    lines = output.splitlines()
    return bool(lines) and all(line.startswith("-") for line in lines)


def delete_merged_branch(bare: Path, branch: str) -> None:
    """Delete a local branch whose changes were verified to be in origin.

    Uses -D because the merged/patch-equivalent verification already happened;
    plain -d cannot recognize squash or cherry-pick merges.
    """
    if git_output(["branch", "-D", branch], cwd=bare) is not None:
        log(f"deleted branch '{branch}'", GREEN)


def remove_worktree(container: Path, worktree: Path, *, force: bool, branch_merged: bool) -> None:
    """Remove a worktree and delete its branch when it was merged."""
    bare = bare_dir(container)
    branch = git_output(["branch", "--show-current"], cwd=worktree)

    # Before removal: closing the window is deferred until gra exits when gra
    # is running in it, and that check needs the window to still be there.
    close_tmux_window(worktree)

    log(f"Removing worktree '{worktree}'")
    remove_args: list[str | Path] = ["worktree", "remove"]
    if force:
        remove_args.append("--force")
    remove_args.append(worktree)
    run_git(remove_args, cwd=bare)

    if branch and branch_merged:
        delete_merged_branch(bare, branch)
    elif branch:
        log(f"kept branch '{branch}'")

    log(f"removed '{worktree.name}'", GREEN)


