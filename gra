def print_repositories(root: Path) -> None:
    """Show every gra repository and every worktree under the gra root."""
    repositories = containers(root)
    print(f"Root: {root}")
    if not repositories:
        print("No repositories found.")
        return

    active_worktree = git_toplevel(Path.cwd())
    current = active_worktree.resolve() if active_worktree else None
    per_repo = parallel_map(
        lambda container: (
            origin_url(bare_dir(container)) or "-",
            worktree_paths(bare_dir(container)),
        ),
        repositories,
    )
    all_paths = [path for _remote, paths in per_repo for path in paths]
    path_info = dict(
        zip(
            all_paths,
            parallel_map(
                lambda p: (worktree_ref(p), worktree_sync(p), fmt_worktree_status(p)),
                all_paths,
            ),
        )
    )

    rows = []
    for container, (remote, paths) in zip(repositories, per_repo):
        if not paths:
            rows.append(["", container.name, "-", "-", "-", "-", remote])
            continue
        for index, path in enumerate(paths):
            marker = "▶" if current and path.resolve() == current else ""
            ref, sync, status = path_info[path]
            rows.append(
                [
                    marker,
                    container.name if index == 0 else "",
                    path.name,
                    ref,
                    sync,
                    status,
                    remote if index == 0 else "",
                ]
            )

    print(f"Repositories: {len(repositories)}  Worktrees: {len(all_paths)}")
    print()
    print_table(
        ["", "REPOSITORY", "WORKTREE", "BRANCH", "SYNC", "STATUS", "REMOTE"], rows
    )


