def parse_args() -> argparse.Namespace:
    root = expand_path(git_output(["config", "--get", "gra.root"]) or FALLBACK_ROOT)

    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "-q", "--quiet", action="store_true", help="do not print status information"
    )
    parser.add_argument(
        "-v", "--version", action="version", version="%(prog)s " + __version__
    )

    subparsers = parser.add_subparsers(required=True, dest="cmd", title="commands")
    install_parser = subparsers.add_parser(
        "install",
        formatter_class=argparse.RawTextHelpFormatter,
        help=f"install gra into '{INSTALL_DIR}'",
        description=(
            f"Install gra into '{INSTALL_DIR}/gra' and enable the bash\n"
            "integration in '~/.bashrc'.\n"
            "Installs the newer of this script and the one on main, so\n"
            "re-running upgrades. Run from a file, --no-check installs that\n"
            "file without looking online."
        ),
    )
    install_parser.add_argument(
        "--no-check",
        action="store_true",
        help="install this script without looking for a newer one",
    )
    install_parser.set_defaults(handler=lambda args: install(check=not args.no_check))

    clone_parser = subparsers.add_parser(
        "clone",
        formatter_class=argparse.RawTextHelpFormatter,
        help="clone a remote repository as a bare checkout",
        description=(
            f"Clone a repository into '{root}/<repo>/{BARE_DIR}'.\n"
            "The local name is the repository name; use --name to override it.\n"
            "A worktree named after an unused name for the repository is\n"
            "created next to it, checked out on origin's default branch;\n"
            "use --no-work to skip it, and --no-tmux to create it without\n"
            "opening a tmux window for it.\n"
            f"--no-submodules records '{SUBMODULES_CONFIG}=false', which every\n"
            "later 'gra work' in this repository honours too.\n"
            f"A GitHub fork gets an '{UPSTREAM_REMOTE}' remote pointing at the\n"
            "repository it came from, which needs gh; --no-upstream skips it,\n"
            f"and '{UPSTREAM_CONFIG}=false' skips it for good."
        ),
    )
    clone_parser.add_argument("url", help="git repository URL to clone")
    clone_parser.add_argument("--name", help="local repository name under the gra root")
    clone_parser.add_argument(
        "--no-work", action="store_true", help="clone only, without a worktree"
    )
    clone_parser.add_argument(
        "--no-tmux", action="store_true", help="do not open a tmux window"
    )
    clone_parser.add_argument(
        "--no-submodules",
        action="store_true",
        help="never initialize submodules in this repository",
    )
    clone_parser.add_argument(
        "--no-upstream",
        action="store_true",
        help="do not add an 'upstream' remote when the repository is a fork",
    )
    clone_parser.set_defaults(
        handler=lambda args: clone(
            args.url,
            args.name,
            args.root,
            no_work=args.no_work,
            no_tmux=args.no_tmux,
            no_submodules=args.no_submodules,
            no_upstream=args.no_upstream,
        )
    )

    ls_parser = subparsers.add_parser(
        "ls",
        formatter_class=argparse.RawTextHelpFormatter,
        help="list repositories and worktrees under the gra root",
        description=(
            f"List repositories and worktrees under '{root}'.\n"
            "SYNC is ahead/behind the upstream branch as of the last fetch;\n"
            "it reads local refs only and never goes to the network.\n"
            "Use --fetch to run 'git fetch --prune --all' in every repository\n"
            "first, several at a time. Only remote-tracking refs move: no\n"
            "worktree, branch or uncommitted change is touched. A repository\n"
            "that cannot be reached is reported and the rest are still fetched."
        ),
    )
    ls_parser.add_argument(
        "--fetch", action="store_true", help="fetch every repository before listing"
    )
    ls_parser.set_defaults(handler=lambda args: print_repositories(args.root, args.fetch))

    work_parser = subparsers.add_parser(
        "work",
        formatter_class=argparse.RawTextHelpFormatter,
        help="work on a branch in a new worktree, or open a worktree's window",
        description=(
            "TARGET is a worktree name or a branch.\n"
            "A worktree name - 'gra work warmhare' - opens that worktree's tmux\n"
            "window, or switches to it when it is already open. It works from\n"
            "anywhere, because a name identifies one worktree on the machine.\n"
            "Anything else is a branch, and always creates a worktree that\n"
            "checks it out (creating and pushing the branch when missing).\n"
            "BRANCH may be part of a name, so a ticket key finds the branch\n"
            "named after it; several matches are listed rather than guessed\n"
            "between.\n"
            "Without TARGET, what this does depends on where it runs:\n"
            "  in the repository folder: create a worktree named after an\n"
            "    unused name for the repository, on a branch picked with fzf,\n"
            "    newest commits first - or detached at origin's default branch\n"
            "  inside a worktree: open that worktree's window, creating nothing"
        ),
    )
    work_parser.add_argument("target", nargs="?", help="worktree name or branch")
    work_parser.set_defaults(handler=lambda args: work(args.target, args.root))

    done_parser = subparsers.add_parser(
        "done",
        formatter_class=argparse.RawTextHelpFormatter,
        help="remove a worktree when its work is in origin",
        description=(
            "Remove a worktree, closing its tmux window first. Removes the\n"
            "current one, or NAME from anywhere.\n"
            "Fetches, then checks that the commits are pushed, that nothing\n"
            "is modified locally, that no Git operation is half finished,\n"
            "that the work is merged into origin's default branch, and what\n"
            "gh says about its pull request. Anything unfinished is listed\n"
            "with what removal would cost and asked about, which --force\n"
            "answers with yes without fetching.\n"
            "The branch is deleted only when its changes are in origin."
        ),
    )
    done_parser.add_argument(
        "name", nargs="?", help="worktree name, for example 'snowwolf'"
    )
    done_parser.add_argument(
        "--force", action="store_true", help="remove without asking, dirty or unmerged"
    )
    done_parser.set_defaults(handler=lambda args: done(args.name, args.root, args.force))

    cd_parser = subparsers.add_parser(
        "cd",
        formatter_class=argparse.RawTextHelpFormatter,
        help="print a worktree path, by name or with fzf",
        description=(
            "Print the path of a worktree, chosen by NAME or with fzf.\n"
            "Use 'eval \"$(gra shell bash)\"' to make 'gra cd' change directories."
        ),
    )
    cd_parser.add_argument("name", nargs="?", help="worktree name, for example 'snowwolf'")
    cd_parser.set_defaults(handler=lambda args: print_cd_target(args.root, args.name))

    shell_parser = subparsers.add_parser(
        "shell",
        formatter_class=argparse.RawTextHelpFormatter,
        help="print shell integration code",
        description="Print shell integration code for eval.",
    )
    shell_parser.add_argument("shell", choices=["bash"], help="shell to initialize")
    shell_parser.set_defaults(handler=lambda args: print_shell_init(args.shell))

    args = parser.parse_args()
    args.root = root
    return args


def main() -> None:
    global _quiet

    args = parse_args()
    _quiet = args.quiet
    args.handler(args)


if __name__ == "__main__":
    os.environ["GIT_ASK_YESNO"] = "1"
    main()
