def run_hook(name: str, container: Path, worktree: Path, branch: str, cwd: Path) -> None:
    """Run one of the container's hooks, if it is there and executable."""
    script = container / name
    if not (script.is_file() and os.access(script, os.X_OK)):
        return
    env = {
        **os.environ,
        "GRA_WORKTREE": str(worktree),
        "GRA_REPO": container.name,
        "GRA_WORD": worktree.name,
        "GRA_BRANCH": branch,
    }
    log(f"running '{script}'")
    result = subprocess.run([str(script)], cwd=cwd, env=env, check=False)
    if result.returncode != 0:
        log(f"'{script}' exited with {result.returncode}", YELLOW)


