def parse_args() -> argparse.Namespace:
    root = expand_path(git_output(["config", "--get", "gra.root"]) or FALLBACK_ROOT)

    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "-q", "--quiet", action="store_true", help="do not print status information"
    )
    parser.add_argument(
        "-v", "--version", action="version", version="%(prog)s " + __version__
    )

    subparsers = parser.add_subparsers(required=True, dest="cmd", title="commands")
    install_parser = subparsers.add_parser(
        "install",
        formatter_class=argparse.RawTextHelpFormatter,
        help=f"install gra into '{INSTALL_DIR}'",
        description=(
            f"Copy this script to '{INSTALL_DIR}/gra' and enable the bash\n"
            "integration in '~/.bashrc'. Re-run to upgrade."
        ),
    )
    install_parser.set_defaults(handler=lambda args: install())

    clone_parser = subparsers.add_parser(
        "clone",
        formatter_class=argparse.RawTextHelpFormatter,
        help="clone a remote repository as a bare checkout",
        description=(
            f"Clone a repository into '{root}/<repo>/{BARE_DIR}'.\n"
            "The local name is the repository name; use --name to override it.\n"
            "No branch is checked out; use 'gra work' to create a worktree."
        ),
    )
    clone_parser.add_argument("url", help="git repository URL to clone")
    clone_parser.add_argument("--name", help="local repository name under the gra root")
    clone_parser.set_defaults(handler=lambda args: clone(args.url, args.name, args.root))

    ls_parser = subparsers.add_parser(
        "ls",
        formatter_class=argparse.RawTextHelpFormatter,
        help="list repositories and worktrees under the gra root",
        description=f"List repositories and worktrees under '{root}'.",
    )
    ls_parser.set_defaults(handler=lambda args: print_repositories(args.root))

    work_parser = subparsers.add_parser(
        "work",
        formatter_class=argparse.RawTextHelpFormatter,
        help="work on a branch, in a new or the current worktree",
        description=(
            "Create a new worktree named after a random unused word.\n"
            "With BRANCH, check it out (creating and pushing it when missing);\n"
            "without, start detached at origin's default branch.\n"
            "Inside tmux, a window named after the worktree is opened; an\n"
            f"executable '{SETUP_FILE}' in the repository then lays out panes.\n"
            "With --switch, reuse the current worktree instead: switch it to\n"
            "BRANCH with the same branch resolution. Refuses when dirty."
        ),
    )
    work_parser.add_argument("branch", nargs="?", help="branch to check out")
    work_parser.add_argument(
        "--switch",
        action="store_true",
        help="switch the current worktree to BRANCH instead of creating one",
    )
    work_parser.add_argument(
        "--no-tmux", action="store_true", help="do not open a tmux window"
    )

    def run_work(args: argparse.Namespace) -> None:
        if args.switch:
            if not args.branch:
                work_parser.error("--switch requires BRANCH")
            switch_in_place(args.branch)
        else:
            work(args.branch, args.root, args.no_tmux)

    work_parser.set_defaults(handler=run_work)

    done_parser = subparsers.add_parser(
        "done",
        formatter_class=argparse.RawTextHelpFormatter,
        help="remove the current worktree when its work is in origin",
        description=(
            "Remove the current worktree and its tmux window.\n"
            "Refuses when the worktree is dirty or has commits that are not\n"
            "merged into origin's default branch; --force overrides both.\n"
            "The branch is deleted only when its changes are in origin."
        ),
    )
    done_parser.add_argument(
        "--force", action="store_true", help="remove even when dirty or unmerged"
    )
    done_parser.set_defaults(handler=lambda args: done(args.force))

    cd_parser = subparsers.add_parser(
        "cd",
        formatter_class=argparse.RawTextHelpFormatter,
        help="print a worktree path, by name or with fzf",
        description=(
            "Print the path of a worktree, chosen by NAME or with fzf.\n"
            "Use 'eval \"$(gra shell bash)\"' to make 'gra cd' change directories."
        ),
    )
    cd_parser.add_argument("name", nargs="?", help="worktree name, for example 'wolf'")
    cd_parser.set_defaults(handler=lambda args: print_cd_target(args.root, args.name))

    shell_parser = subparsers.add_parser(
        "shell",
        formatter_class=argparse.RawTextHelpFormatter,
        help="print shell integration code",
        description="Print shell integration code for eval.",
    )
    shell_parser.add_argument("shell", choices=["bash"], help="shell to initialize")
    shell_parser.set_defaults(handler=lambda args: print_shell_init(args.shell))

    tmux_parser = subparsers.add_parser(
        "tmux",
        formatter_class=argparse.RawTextHelpFormatter,
        help="open a worktree in tmux, by name or with fzf",
        description=(
            "Open a worktree in a tmux window named after the worktree.\n"
            "Choose the worktree by NAME or with fzf."
        ),
    )
    tmux_parser.add_argument("name", nargs="?", help="worktree name, for example 'wolf'")
    tmux_parser.add_argument(
        "--session",
        default=DEFAULT_TMUX_SESSION,
        help=f"tmux session name to create or update (default: {DEFAULT_TMUX_SESSION})",
    )
    tmux_parser.set_defaults(
        handler=lambda args: open_tmux_window(args.root, args.session, args.name)
    )

    clean_parser = subparsers.add_parser(
        "clean",
        formatter_class=argparse.RawTextHelpFormatter,
        help="report or remove clean merged worktrees",
        description=(
            f"Classify worktrees in every repository under '{root}':\n"
            "  keep  - .grakeep marker, dirty, or has commits not in origin's default branch\n"
            "  remove - clean and merged or patch-equivalent in origin's default branch\n"
            "  prune - the worktree path no longer exists on disk\n"
            "Without --yes, only prints the table."
        ),
    )
    clean_parser.add_argument(
        "--yes", action="store_true", help="actually remove removable worktrees and prune missing ones"
    )
    clean_parser.add_argument(
        "--no-fetch", action="store_true", help="skip 'git fetch --prune origin' before classifying"
    )
    clean_parser.set_defaults(handler=lambda args: clean(args.root, args.yes, not args.no_fetch))

    args = parser.parse_args()
    args.root = root
    return args


def main() -> None:
    global _quiet

    args = parse_args()
    _quiet = args.quiet
    args.handler(args)


if __name__ == "__main__":
    os.environ["GIT_ASK_YESNO"] = "1"
    main()
