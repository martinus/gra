def print_repositories(root: Path) -> None:
    """Show every gra repository and every worktree under the gra root."""
    repositories = containers(root)
    print(f"Root: {root}")
    if not repositories:
        print("No repositories found.")
        return

    active_worktree = git_toplevel(Path.cwd())
    current = active_worktree.resolve() if active_worktree else None
    per_repo = parallel_map(
        lambda container: (
            origin_url(bare_dir(container)) or "-",
            worktree_paths(bare_dir(container)),
        ),
        repositories,
    )
    all_paths = [path for _remote, paths in per_repo for path in paths]
    path_info = dict(
        zip(
            all_paths,
            parallel_map(lambda p: (worktree_ref(p), fmt_worktree_status(p)), all_paths),
        )
    )

    rows = []
    for container, (remote, paths) in zip(repositories, per_repo):
        if not paths:
            rows.append(["", container.name, "-", "-", "-", remote])
            continue
        for index, path in enumerate(paths):
            marker = "▶" if current and path.resolve() == current else ""
            ref, status = path_info[path]
            rows.append(
                [
                    marker,
                    container.name if index == 0 else "",
                    path.name,
                    ref,
                    status,
                    remote if index == 0 else "",
                ]
            )

    print(f"Repositories: {len(repositories)}  Worktrees: {len(all_paths)}")
    print()
    print_table(["", "REPOSITORY", "WORKTREE", "BRANCH", "STATUS", "REMOTE"], rows)


# ---------------------------------------------------------------------------
# Picker helpers (cd, tmux)
# ---------------------------------------------------------------------------


class WorktreeRow(NamedTuple):
    """One worktree in pickers and machine-readable listings."""

    path: str
    repo: str
    word: str
    ref: str

    def values(self) -> list[str]:
        return [self.repo, self.word, self.ref]


def local_worktree_picker_rows(root: Path) -> list[WorktreeRow]:
    """Return local worktree picker rows under the gra root."""
    entries = [
        (container.name, path)
        for container in containers(root)
        for path in worktree_paths(bare_dir(container))
        if path.is_dir()
    ]
    refs = parallel_map(lambda entry: worktree_ref(entry[1]), entries)
    return [
        WorktreeRow(str(path), repo, path.name, ref)
        for (repo, path), ref in zip(entries, refs)
    ]


PICKER_HEADERS = ["REPOSITORY", "WORKTREE", "BRANCH"]


def worktree_picker_choices(rows: list[WorktreeRow]) -> tuple[list[str], str]:
    """Return fzf input lines and an aligned header."""
    widths = column_widths(PICKER_HEADERS, [row.values() for row in rows], include_headers=False)
    choices = [f"{row.path}\t{padded_line(row.values(), widths)}" for row in rows]
    return choices, padded_line(PICKER_HEADERS, widths)


def select_worktree_row_from_rows(
    rows: list[WorktreeRow], command: str, source: str
) -> WorktreeRow:
    """Select a worktree with fzf and return its picker row."""
    choices, header = worktree_picker_choices(rows)
    if not choices:
        fail(f"no worktrees found {source}")

    if not shutil.which("fzf"):
        fail(f"fzf is required for 'gra {command}'")

    result = subprocess.run(
        [
            "fzf",
            "--height=80%",
            "--layout=reverse",
            "--border",
            "--tiebreak=begin,index",
            f"--prompt=gra {command}> ",
            f"--header={header}",
            "--delimiter=\t",
            "--with-nth=2",
        ],
        input="\n".join(choices) + "\n",
        stdout=subprocess.PIPE,
        encoding="utf-8",
        check=False,
    )
    if result.returncode != 0:
        sys.exit(result.returncode)

    selected = result.stdout.rstrip("\n")
    if not selected:
        sys.exit(1)
    target = selected.split("\t", 1)[0]
    for row in rows:
        if row.path == target:
            return row
    fail(f"invalid worktree selection '{target}'")


def resolve_worktree_name(root: Path, name: str) -> WorktreeRow:
    """Resolve a worktree name like 'wolf' to its row.

    Names are unique across all repositories and worktrees always live directly
    under their container, so a filesystem probe finds the worktree without
    querying Git in every repository.
    """
    for container in containers(root):
        path = container / name
        if name != BARE_DIR and path.is_dir():
            return WorktreeRow(str(path), container.name, name, worktree_ref(path))
    fail(f"no worktree named '{name}' under '{root}'")


def pick_worktree_row(root: Path, command: str, name: str | None = None) -> WorktreeRow:
    """Resolve a worktree by name, or select one with fzf."""
    if name:
        return resolve_worktree_name(root, name)
    return select_worktree_row_from_rows(
        local_worktree_picker_rows(root), command, f"under '{root}'"
    )


def print_cd_target(root: Path, name: str | None) -> None:
    """Print the path of a worktree chosen by name or with fzf."""
    print(pick_worktree_row(root, "cd", name).path)


# ---------------------------------------------------------------------------
# tmux helpers and command
# ---------------------------------------------------------------------------


TMUX_WINDOW_LIST_FORMAT = "#{window_name}\t#{window_id}"


def tmux_window_name(container_name: str, word: str) -> str:
    return f"{container_name}/{word}"


def run_tmux(args: list[str | Path]) -> None:
    subprocess.run(["tmux", *args], check=True)


def tmux_session_exists(session: str) -> bool:
    result = subprocess.run(
        ["tmux", "has-session", "-t", session],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return result.returncode == 0


def tmux_window_targets(session: str) -> dict[str, str]:
    result = subprocess.run(
        ["tmux", "list-windows", "-t", session, "-F", TMUX_WINDOW_LIST_FORMAT],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        encoding="utf-8",
        check=False,
    )
    if result.returncode != 0:
        detail = result.stderr.strip()
        fail(f"could not list tmux windows in '{session}'" + (f": {detail}" if detail else ""))
    windows = {}
    for line in result.stdout.splitlines():
        name, window_id = line.split("\t", 1)
        windows[name] = window_id
    return windows


def inside_tmux() -> bool:
    return bool(os.environ.get("TMUX")) and bool(shutil.which("tmux"))


def open_tmux_window_for_worktree(session: str, name: str, target: str | Path) -> None:
    """Open or select a tmux window named after the worktree, in a session."""
    if tmux_session_exists(session):
        if existing_target := tmux_window_targets(session).get(name):
            run_tmux(["select-window", "-t", existing_target])
            log(f"selected tmux window '{name}' in session '{session}'", GREEN)
            return
        run_tmux(["new-window", "-t", f"{session}:", "-n", name, "-c", target])
        log(f"created tmux window '{name}' in session '{session}'", GREEN)
        return

    run_tmux(["new-session", "-d", "-s", session, "-n", name, "-c", target])
    log(f"created tmux session '{session}' with window '{name}'", GREEN)


def new_tmux_window(name: str, target: Path) -> str:
    """Create a tmux window in the current session; return its window id."""
    return subprocess.check_output(
        ["tmux", "new-window", "-P", "-F", "#{window_id}", "-n", name, "-c", target],
        encoding="utf-8",
    ).strip()


def run_setup_hook(
    container: Path, worktree: Path, word: str, branch: str, window_id: str
) -> None:
    """Run the container's .tmux-setup hook for a new worktree window.

    The hook is skipped unless it exists and is executable, so the commented
    sample written by 'gra clone' stays inert until the user opts in.
    """
    script = container / SETUP_FILE
    if not (script.is_file() and os.access(script, os.X_OK)):
        return
    env = {
        **os.environ,
        "GRA_WORKTREE": str(worktree),
        "GRA_WINDOW": window_id,
        "GRA_REPO": container.name,
        "GRA_WORD": word,
        "GRA_BRANCH": branch,
    }
    log(f"running '{script}'")
    subprocess.run([str(script)], cwd=worktree, env=env, check=False)


def open_work_window(container: Path, worktree: Path, word: str, branch: str) -> None:
    """Open a tmux window for a freshly created worktree and run its hook."""
    name = tmux_window_name(container.name, word)
    window_id = new_tmux_window(name, worktree)
    log(f"created tmux window '{name}'", GREEN)
    run_setup_hook(container, worktree, word, branch, window_id)


def open_tmux_window(root: Path, session: str, name: str | None) -> None:
    """Choose a worktree by name or with fzf and open it in tmux."""
    if not session or session.startswith("-"):
        fail(f"invalid tmux session '{session}'")
    if not shutil.which("tmux"):
        fail("tmux is required for 'gra tmux'")

    row = pick_worktree_row(root, "tmux", name)
    open_tmux_window_for_worktree(session, tmux_window_name(row.repo, row.word), row.path)


def kill_tmux_windows(name: str) -> None:
    """Kill tmux windows named after a removed worktree, in any session."""
    if not shutil.which("tmux"):
        return
    result = subprocess.run(
        ["tmux", "list-windows", "-a", "-F", TMUX_WINDOW_LIST_FORMAT],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        encoding="utf-8",
        check=False,
    )
    if result.returncode != 0:
        return
    for line in result.stdout.splitlines():
        window_name, _, window_id = line.partition("\t")
        if window_name == name:
            log(f"killing tmux window '{name}'")
            subprocess.run(["tmux", "kill-window", "-t", window_id], check=False)


# ---------------------------------------------------------------------------
# install command
# ---------------------------------------------------------------------------


SOURCE_URL = "https://raw.githubusercontent.com/martinus/gra/main/gra"
INSTALL_DIR = "~/.local/bin"
SHELL_INIT_LINE = 'eval "$(gra shell bash)"'


def gra_source() -> bytes:
    """Return this script's own source.

    Running from a file - a checkout or an earlier install - copies that file,
    so 'gra install' from a checkout installs the checkout. Under
    'python3 -c' there is no file to copy, so the source is downloaded.
    """
    path = globals().get("__file__")
    if path and Path(path).is_file():
        return Path(path).read_bytes()
    log(f"downloading {SOURCE_URL}")
    try:
        with urllib.request.urlopen(SOURCE_URL) as response:
            return response.read()
    except OSError as error:
        fail(f"cannot download {SOURCE_URL}: {error}")


def install_script() -> Path:
    """Write this script to the install directory and make it executable."""
    source = gra_source()
    target = expand_path(INSTALL_DIR) / "gra"
    try:
        target.parent.mkdir(parents=True, exist_ok=True)
        # Unlink first: an earlier install may have left a symlink here, and
        # writing through it would modify whatever it points at.
        target.unlink(missing_ok=True)
        target.write_bytes(source)
        target.chmod(0o755)
    except OSError as error:
        fail(f"cannot write '{target}': {error}")
    return target


def is_on_path(directory: Path) -> bool:
    entries = os.environ.get("PATH", "").split(os.pathsep)
    return any(entry and expand_path(entry) == directory for entry in entries)


def shell_init_block(directory: Path) -> str:
    """Bash lines that put gra on the PATH and enable 'gra cd' and 'gra done'."""
    lines = ["", "# gra"]
    if not is_on_path(directory):
        lines.append(f'export PATH="{INSTALL_DIR.replace("~", "$HOME")}:$PATH"')
    lines.append(SHELL_INIT_LINE)
    return "\n".join(lines) + "\n"


def install() -> None:
    target = install_script()
    log(f"installed gra {__version__} to '{target}'")

    block = shell_init_block(target.parent)
    bashrc = expand_path("~/.bashrc")
    if not bashrc.is_file():
        log(f"no '{bashrc}'; add this to your shell configuration:")
        print(block, end="")
        return
    if SHELL_INIT_LINE in bashrc.read_text():
        log(f"shell integration already in '{bashrc}'")
        return
    try:
        with bashrc.open("a") as handle:
            handle.write(block)
    except OSError as error:
        fail(f"cannot write '{bashrc}': {error}")
    log(f"added shell integration to '{bashrc}'; restart your shell")


# ---------------------------------------------------------------------------
# shell command
# ---------------------------------------------------------------------------


BASH_INIT = r'''gra() {
    case ${1-} in
        cd)
            shift
            local target
            target="$(command gra cd "$@")" || return
            [[ -n $target ]] && builtin cd "$target"
            ;;
        done)
            local dir=$PWD
            command gra "$@" || return
            [[ -d $dir ]] || builtin cd "${dir%/*}"
            ;;
        *)
            command gra "$@"
            ;;
    esac
}
'''


def print_shell_init(shell: str) -> None:
    """Print shell integration code for eval."""
    if shell == "bash":
        print(BASH_INIT, end="")
        return
    fail(f"unsupported shell '{shell}'")


# ---------------------------------------------------------------------------
# Branch resolution for the work command
# ---------------------------------------------------------------------------


def create_missing_branch(bare: Path, branch: str) -> None:
    start_point = remote_default_branch(bare)
    if not start_point:
        fail(f"cannot resolve branch '{branch}' and cannot find origin's default branch")

    if not ask_yes_no(f"Branch '{branch}' does not exist. Create it from '{start_point}'?"):
        fail(f"branch '{branch}' was not created")

    run_git(["branch", branch, start_point], cwd=bare)
    run_git(["push", "--set-upstream", "origin", branch], cwd=bare)
    log(f"created branch '{branch}' from '{start_point}' and tracking 'origin/{branch}'", GREEN)


def branch_needs_tracking(bare: Path, branch: str) -> bool:
    """Ensure branch exists locally or on origin; return True when tracking is needed."""
    if local_branch_exists(bare, branch):
        return False
    if remote_branch_exists(bare, branch):
        return True
    create_missing_branch(bare, branch)
    return False


def add_attached_worktree(bare: Path, target: Path, branch: str) -> None:
    """Create a worktree that checks out branch, tracking origin if needed."""
    if branch_needs_tracking(bare, branch):
        run_git(
            ["worktree", "add", "--track", "-b", branch, target, f"origin/{branch}"],
            cwd=bare,
        )
        return
    run_git(["worktree", "add", target, branch], cwd=bare)


def init_submodules(worktree: Path) -> None:
    if (worktree / ".gitmodules").is_file():
        log(f"Initializing submodules in '{worktree}'")
        run_git(["submodule", "update", "--init", "--recursive"], cwd=worktree)


# ---------------------------------------------------------------------------
# work command
# ---------------------------------------------------------------------------


def switch_in_place(branch_input: str) -> None:
    """Switch the current worktree to another branch."""
    container, worktree = current_gra_worktree("work --switch")
    bare = bare_dir(container)
    branch = branch_name_from_input(branch_input)

    if worktree_status_output(worktree):
        fail(
            f"'{worktree}' has uncommitted changes; commit or stash them before switching"
        )

    log(f"Switching '{worktree}' to '{branch}'")
    if branch_needs_tracking(bare, branch):
        run_git(["switch", "--track", f"origin/{branch}"], cwd=worktree)
    else:
        run_git(["switch", branch], cwd=worktree)
    log(f"'{worktree.name}' is now on '{branch}'", GREEN)


def work(branch_input: str | None, root: Path, no_tmux: bool) -> None:
    """Create a new worktree with a fresh random name."""
    container = find_container(Path.cwd())
    if not container:
        fail(
            "gra work must be run from inside a repository under the gra root;\n"
            "use 'gra ls' to see repositories or 'gra clone URL' to add one"
        )
    bare = bare_dir(container)
    word = pick_worktree_name(root)
    target = container / word

    if branch_input:
        branch = branch_name_from_input(branch_input)
        log(f"Creating worktree '{target}' for branch '{branch}'")
        add_attached_worktree(bare, target, branch)
    else:
        branch = ""
        ref = remote_default_branch(bare)
        if not ref:
            fail("cannot find origin's default branch; pass a branch to 'gra work'")
        log(f"Creating worktree '{target}' detached at '{ref}'")
        run_git(["worktree", "add", "--detach", target, ref], cwd=bare)

    init_submodules(target)
    log(f"created '{target}'", GREEN)

    if not no_tmux and inside_tmux():
        open_work_window(container, target, word, branch)


# ---------------------------------------------------------------------------
# Merge state probes shared by done and clean
# ---------------------------------------------------------------------------


def is_merged_into(path: Path, ref: str) -> bool:
    """Return True if HEAD at path is reachable from ref."""
    result = subprocess.run(
        ["git", "merge-base", "--is-ancestor", "HEAD", ref],
        cwd=path,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return result.returncode == 0


def has_patch_equivalent_changes_in(path: Path, ref: str) -> bool:
    """Return True if commits unique to HEAD have matching patch IDs in ref."""
    output = git_output(["cherry", ref, "HEAD"], cwd=path)
    if output is None:
        return False
    lines = output.splitlines()
    return bool(lines) and all(line.startswith("-") for line in lines)


def delete_merged_branch(bare: Path, branch: str) -> None:
    """Delete a local branch whose changes were verified to be in origin.

    Uses -D because the merged/patch-equivalent verification already happened;
    plain -d cannot recognize squash or cherry-pick merges.
    """
    if git_output(["branch", "-D", branch], cwd=bare) is not None:
        log(f"deleted branch '{branch}'", GREEN)


def remove_worktree(container: Path, worktree: Path, *, force: bool, branch_merged: bool) -> None:
    """Remove a worktree, delete its merged branch, and kill its tmux window."""
    bare = bare_dir(container)
    branch = git_output(["branch", "--show-current"], cwd=worktree)

    log(f"Removing worktree '{worktree}'")
    remove_args: list[str | Path] = ["worktree", "remove"]
    if force:
        remove_args.append("--force")
    remove_args.append(worktree)
    run_git(remove_args, cwd=bare)

    if branch and branch_merged:
        delete_merged_branch(bare, branch)
    elif branch:
        log(f"kept branch '{branch}'")

    log(f"removed '{worktree.name}'", GREEN)
    kill_tmux_windows(tmux_window_name(container.name, worktree.name))


# ---------------------------------------------------------------------------
# done command
# ---------------------------------------------------------------------------


def done(force: bool) -> None:
    """Remove the current worktree once its work is safely in origin."""
    container, worktree = current_gra_worktree("done")
    bare = bare_dir(container)

    if worktree_status_output(worktree) and not force:
        fail(f"'{worktree}' has uncommitted changes; commit them or use --force")

    default_ref = remote_default_branch(bare)
    merged = bool(default_ref) and (
        is_merged_into(worktree, default_ref)
        or has_patch_equivalent_changes_in(worktree, default_ref)
    )
    if not merged and not force:
        fail(
            f"'{worktree}' has commits not in {default_ref or 'origin'}; "
            "push and merge them first, or use --force"
        )

    remove_worktree(container, worktree, force=force, branch_merged=merged)


# ---------------------------------------------------------------------------
# clean command
# ---------------------------------------------------------------------------


def fetch_repository(bare: Path) -> None:
    subprocess.run(
        ["git", "fetch", "--prune", "origin"],
        cwd=bare,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )


def fetch_repositories(bares: list[Path]) -> None:
    parallel_map(fetch_repository, bares)


def classify_worktree(
    path: Path,
    default_ref: str | None,
    status_output: str | None = None,
) -> tuple[str, str]:
    """Return (verdict, reason) for a worktree path. Verdict is keep/remove/prune."""
    if not path.exists():
        return ("prune", "missing path")
    if (path / GRAKEEP_FILE).is_file():
        return ("keep", f"{GRAKEEP_FILE} marker")
    if status_output is None:
        status_output = worktree_status_output(path)
    if status_output:
        return ("keep", "uncommitted changes")
    if not default_ref:
        return ("keep", "origin default branch unknown")
    if is_merged_into(path, default_ref):
        return ("remove", f"merged into {default_ref}")
    if has_patch_equivalent_changes_in(path, default_ref):
        return ("remove", f"changes already in {default_ref}")
    return ("keep", f"has commits not in {default_ref}")


class CleanEntry(NamedTuple):
    path: Path
    ref: str
    status: str
    verdict: str
    reason: str


def clean_worktree_entry(path: Path, default_ref: str | None) -> CleanEntry:
    status_output = worktree_status_output(path) if path.exists() else ""
    verdict, reason = classify_worktree(path, default_ref, status_output)
    return CleanEntry(
        path,
        worktree_ref(path),
        fmt_worktree_status(path, status_output),
        verdict,
        reason,
    )


def clean_repository_entries(container: Path) -> list[CleanEntry]:
    """Classify worktrees in one repository."""
    bare = bare_dir(container)
    default_ref = remote_default_branch(bare)
    return parallel_map(
        lambda path: clean_worktree_entry(path, default_ref), worktree_paths(bare)
    )


def apply_clean(container: Path, entries: list[CleanEntry]) -> None:
    """Remove removable worktrees and prune missing entries for one repository."""
    has_missing = False
    for entry in entries:
        if entry.verdict == "prune":
            has_missing = True
        elif entry.verdict == "remove":
            remove_worktree(container, entry.path, force=False, branch_merged=True)
    if has_missing:
        log(f"Pruning missing worktree entries in '{container.name}'")
        run_git(["worktree", "prune"], cwd=bare_dir(container))


def clean(root: Path, yes: bool, fetch: bool) -> None:
    """Report cleanable worktrees across every gra repository under root."""
    repositories = containers(root)
    print(f"Root: {root}")
    if not repositories:
        print("No repositories found.")
        return

    if fetch:
        log(f"Fetching origin for {len(repositories)} repositories")
        fetch_repositories([bare_dir(container) for container in repositories])

    repo_entries = [
        (container, clean_repository_entries(container)) for container in repositories
    ]

    rows = []
    for container, entries in repo_entries:
        for index, entry in enumerate(entries):
            rows.append(
                [
                    container.name if index == 0 else "",
                    entry.path.name,
                    entry.ref,
                    entry.status,
                    entry.verdict,
                    entry.reason,
                ]
            )

    total_removable = sum(
        1 for _c, entries in repo_entries for e in entries if e.verdict == "remove"
    )
    total_missing = sum(
        1 for _c, entries in repo_entries for e in entries if e.verdict == "prune"
    )

    print(f"Repositories: {len(repositories)}  Worktrees: {len(rows)}")
    print()
    print_table(["REPOSITORY", "WORKTREE", "BRANCH", "STATUS", "VERDICT", "REASON"], rows)

    print()
    if not total_removable and not total_missing:
        log("Nothing to clean.", GREEN)
        return

    if not yes:
        actions = []
        if total_removable:
            actions.append(f"remove {total_removable} worktree(s)")
        if total_missing:
            entries_word = "entry" if total_missing == 1 else "entries"
            actions.append(f"prune {total_missing} missing {entries_word}")
        log(f"Dry run. Re-run with --yes to {' and '.join(actions)}.", YELLOW)
        return

    for container, entries in repo_entries:
        if any(e.verdict in {"remove", "prune"} for e in entries):
            apply_clean(container, entries)

    print()
    log(
        f"Removed {total_removable} worktree(s); pruned missing entries in {total_missing} place(s).",
        GREEN,
    )


