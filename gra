def fzf_table(
    command: str, headers: list[str], entries: list[tuple[str, list[str]]]
) -> str:
    """Select from (key, columns) entries with fzf and return the chosen key.

    Owns the whole table convention - aligned columns behind a hidden key -
    so every picker lays out and selects the same way. A cancelled fzf exits
    this process with fzf's own status, so callers only ever see a selection
    that was actually made.
    """
    if not shutil.which("fzf"):
        fail(f"fzf is required for '{command}'")

    widths = column_widths(
        headers, [cells for _key, cells in entries], include_headers=False
    )
    choices = [f"{key}\t{padded_line(cells, widths)}" for key, cells in entries]
    header = padded_line(headers, widths)

    result = subprocess.run(
        [
            "fzf",
            "--height=80%",
            "--layout=reverse",
            "--border",
            "--tiebreak=begin,index",
            f"--prompt={command}> ",
            f"--header={header}",
            "--delimiter=\t",
            "--with-nth=2",
        ],
        input="\n".join(choices) + "\n",
        stdout=subprocess.PIPE,
        encoding="utf-8",
        check=False,
    )
    if result.returncode != 0:
        sys.exit(result.returncode)

    selected = result.stdout.rstrip("\n")
    if not selected:
        sys.exit(1)
    return selected.split("\t", 1)[0]


class WorktreeRow(NamedTuple):
    """One worktree in pickers and machine-readable listings."""

    path: str
    repo: str
    word: str
    ref: str

    def values(self) -> list[str]:
        return [self.repo, self.word, self.ref]


def local_worktree_picker_rows(root: Path) -> list[WorktreeRow]:
    """Return local worktree picker rows under the gra root."""
    entries = [
        (container.name, path)
        for container in containers(root)
        for path in worktree_paths(bare_dir(container))
        if path.is_dir()
    ]
    refs = parallel_map(lambda entry: worktree_ref(entry[1]), entries)
    return [
        WorktreeRow(str(path), repo, path.name, ref)
        for (repo, path), ref in zip(entries, refs)
    ]


PICKER_HEADERS = ["REPOSITORY", "WORKTREE", "BRANCH"]


def select_worktree_row_from_rows(rows: list[WorktreeRow], source: str) -> WorktreeRow:
    """Select a worktree with fzf and return its picker row."""
    if not rows:
        fail(f"no worktrees found {source}")
    target = fzf_table("gra cd", PICKER_HEADERS, [(row.path, row.values()) for row in rows])
    for row in rows:
        if row.path == target:
            return row
    fail(f"invalid worktree selection '{target}'")


def resolve_worktree_name(root: Path, name: str) -> WorktreeRow:
    """Resolve a worktree name like 'snowwolf' to its row.

    Names are unique across all repositories and worktrees always live directly
    under their container, so a filesystem probe finds the worktree without
    querying Git in every repository.
    """
    for container in containers(root):
        path = container / name
        if name != BARE_DIR and path.is_dir():
            return WorktreeRow(str(path), container.name, name, worktree_ref(path))
    fail(f"no worktree named '{name}' under '{root}'")


def pick_worktree_row(root: Path, name: str | None = None) -> WorktreeRow:
    """Resolve a worktree by name, or select one with fzf."""
    if name:
        return resolve_worktree_name(root, name)
    return select_worktree_row_from_rows(
        local_worktree_picker_rows(root), f"under '{root}'"
    )


def print_cd_target(root: Path, name: str | None) -> None:
    """Print the path of a worktree chosen by name or with fzf."""
    print(pick_worktree_row(root, name).path)


