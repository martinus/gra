def parse_args() -> argparse.Namespace:
    root = expand_path(git_output(["config", "--get", "gra.root"]) or FALLBACK_ROOT)

    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "-q", "--quiet", action="store_true", help="do not print status information"
    )
    parser.add_argument(
        "-v", "--version", action="version", version="%(prog)s " + __version__
    )

    subparsers = parser.add_subparsers(required=True, dest="cmd", title="commands")
    install_parser = subparsers.add_parser(
        "install",
        formatter_class=argparse.RawTextHelpFormatter,
        help=f"install gra into '{INSTALL_DIR}'",
        description=(
            f"Install gra into '{INSTALL_DIR}/gra' and enable the bash\n"
            "integration in '~/.bashrc'.\n"
            "Installs the newer of this script and the one on main, so\n"
            "re-running upgrades. Run from a file, --no-check installs that\n"
            "file without looking online."
        ),
    )
    install_parser.add_argument(
        "--no-check",
        action="store_true",
        help="install this script without looking for a newer one",
    )
    install_parser.set_defaults(handler=lambda args: install(check=not args.no_check))

    clone_parser = subparsers.add_parser(
        "clone",
        formatter_class=argparse.RawTextHelpFormatter,
        help="clone a remote repository as a bare checkout",
        description=(
            f"Clone a repository into '{root}/<repo>/{BARE_DIR}'.\n"
            "The local name is the repository name; use --name to override it.\n"
            "A worktree named after an unused name for the repository is\n"
            "created next to it, checked out on origin's default branch;\n"
            f"use --no-work to skip it. Writes '{WORK_HOOK}' and '{DONE_HOOK}'\n"
            f"hooks next to '{BARE_DIR}' and runs the first.\n"
            f"--no-submodules records '{SUBMODULES_CONFIG}=false', which every\n"
            "later 'gra work' in this repository honours too.\n"
            f"A GitHub fork gets an '{UPSTREAM_REMOTE}' remote pointing at the\n"
            "repository it came from, which needs gh; --no-upstream skips it,\n"
            f"and '{UPSTREAM_CONFIG}=false' skips it for good."
        ),
    )
    clone_parser.add_argument("url", help="git repository URL to clone")
    clone_parser.add_argument("--name", help="local repository name under the gra root")
    clone_parser.add_argument(
        "--no-work", action="store_true", help="clone only, without a worktree"
    )
    clone_parser.add_argument(
        "--no-hook", action="store_true", help=f"do not run the '{WORK_HOOK}' hook"
    )
    clone_parser.add_argument(
        "--no-submodules",
        action="store_true",
        help="never initialize submodules in this repository",
    )
    clone_parser.add_argument(
        "--no-upstream",
        action="store_true",
        help="do not add an 'upstream' remote when the repository is a fork",
    )
    clone_parser.set_defaults(
        handler=lambda args: clone(
            args.url,
            args.name,
            args.root,
            no_work=args.no_work,
            no_hook=args.no_hook,
            no_submodules=args.no_submodules,
            no_upstream=args.no_upstream,
        )
    )

    ls_parser = subparsers.add_parser(
        "ls",
        formatter_class=argparse.RawTextHelpFormatter,
        help="list repositories and worktrees under the gra root",
        description=(
            f"List repositories and worktrees under '{root}'.\n"
            "SYNC is ahead/behind the upstream branch as of the last fetch;\n"
            "it reads local refs only and never goes to the network."
        ),
    )
    ls_parser.set_defaults(handler=lambda args: print_repositories(args.root))

    work_parser = subparsers.add_parser(
        "work",
        formatter_class=argparse.RawTextHelpFormatter,
        help="work on a branch in a new worktree, or set this one up again",
        description=(
            "What this does depends on where it runs:\n"
            "  in the repository folder: create a worktree named after an\n"
            f"    unused name for the repository, and run '{WORK_HOOK}' inside it\n"
            f"  inside a worktree: run the '{WORK_HOOK}' hook again, creating nothing\n"
            "With BRANCH, always create a worktree that checks it out (creating\n"
            "and pushing the branch when missing). BRANCH may be part of a name,\n"
            "so a ticket key finds the branch named after it; several matches\n"
            "are listed rather than guessed between.\n"
            "Without BRANCH in the repository folder, pick one with fzf, newest\n"
            "commits first - or start detached at origin's default branch."
        ),
    )
    work_parser.add_argument("branch", nargs="?", help="branch to check out")
    work_parser.set_defaults(handler=lambda args: work(args.branch, args.root))

    switch_parser = subparsers.add_parser(
        "switch",
        formatter_class=argparse.RawTextHelpFormatter,
        help="switch the current worktree to another branch",
        description=(
            "Switch the worktree you are standing in to BRANCH, with the same\n"
            "branch resolution as 'gra work': part of a name is enough when it\n"
            "matches one branch, and a missing branch can be created from\n"
            "origin's default branch and pushed.\n"
            "Without BRANCH, pick one with fzf, newest commits first.\n"
            "Refuses when the worktree has uncommitted changes.\n"
            f"Runs the repository's '{WORK_HOOK}' hook after switching."
        ),
    )
    switch_parser.add_argument("branch", nargs="?", help="branch to switch to")
    switch_parser.set_defaults(handler=lambda args: switch(args.branch))

    done_parser = subparsers.add_parser(
        "done",
        formatter_class=argparse.RawTextHelpFormatter,
        help="remove a worktree when its work is in origin",
        description=(
            f"Remove a worktree, running the repository's '{DONE_HOOK}' hook\n"
            "first. Removes the current one, or NAME from anywhere.\n"
            "Refuses when the worktree is dirty or has commits that are not\n"
            "merged into origin's default branch; --force overrides both.\n"
            "The branch is deleted only when its changes are in origin."
        ),
    )
    done_parser.add_argument(
        "name", nargs="?", help="worktree name, for example 'snowwolf'"
    )
    done_parser.add_argument(
        "--force", action="store_true", help="remove even when dirty or unmerged"
    )
    done_parser.set_defaults(handler=lambda args: done(args.name, args.root, args.force))

    cd_parser = subparsers.add_parser(
        "cd",
        formatter_class=argparse.RawTextHelpFormatter,
        help="print a worktree path, by name or with fzf",
        description=(
            "Print the path of a worktree, chosen by NAME or with fzf.\n"
            "Use 'eval \"$(gra shell bash)\"' to make 'gra cd' change directories."
        ),
    )
    cd_parser.add_argument("name", nargs="?", help="worktree name, for example 'snowwolf'")
    cd_parser.set_defaults(handler=lambda args: print_cd_target(args.root, args.name))

    shell_parser = subparsers.add_parser(
        "shell",
        formatter_class=argparse.RawTextHelpFormatter,
        help="print shell integration code",
        description="Print shell integration code for eval.",
    )
    shell_parser.add_argument("shell", choices=["bash"], help="shell to initialize")
    shell_parser.set_defaults(handler=lambda args: print_shell_init(args.shell))

    hooks_parser = subparsers.add_parser(
        "hooks",
        formatter_class=argparse.RawTextHelpFormatter,
        help="write missing hooks into every repository",
        description=(
            f"Write '{WORK_HOOK}' and '{DONE_HOOK}' into every repository under\n"
            f"'{root}' that is missing them. Existing hooks are left alone,\n"
            "so this is safe to re-run and cannot overwrite your edits."
        ),
    )
    hooks_parser.set_defaults(handler=lambda args: write_missing_hooks(args.root))

    clean_parser = subparsers.add_parser(
        "clean",
        formatter_class=argparse.RawTextHelpFormatter,
        help="report or remove clean merged worktrees",
        description=(
            f"Classify worktrees in every repository under '{root}':\n"
            "  keep  - .grakeep marker, dirty, or has commits not in origin's default branch\n"
            "  remove - clean and merged or patch-equivalent in origin's default branch\n"
            "  prune - the worktree path no longer exists on disk\n"
            "Without --yes, only prints the table.\n"
            f"Each removal runs the repository's '{DONE_HOOK}' hook first."
        ),
    )
    clean_parser.add_argument(
        "--yes", action="store_true", help="actually remove removable worktrees and prune missing ones"
    )
    clean_parser.add_argument(
        "--no-fetch", action="store_true", help="skip 'git fetch --prune origin' before classifying"
    )
    clean_parser.set_defaults(handler=lambda args: clean(args.root, args.yes, not args.no_fetch))

    args = parser.parse_args()
    args.root = root
    return args


def main() -> None:
    global _quiet

    args = parse_args()
    _quiet = args.quiet
    args.handler(args)


if __name__ == "__main__":
    os.environ["GIT_ASK_YESNO"] = "1"
    main()
