# ---------------------------------------------------------------------------
# Process and output helpers
# ---------------------------------------------------------------------------


def expand_path(path: str) -> Path:
    return Path(os.path.expandvars(os.path.expanduser(path)))


def log(msg: str, color: str = BLUE) -> None:
    if not _quiet:
        print(f"{color}{msg}{ENDC}")


def style(text: str, *colors: str) -> str:
    code = "".join(colors)
    return f"{code}{text}{ENDC}" if code else text


def fail(msg: str) -> NoReturn:
    print(f"{RED}ERROR: {msg}{ENDC}", file=sys.stderr)
    sys.exit(1)


def ask_yes_no(question: str) -> bool:
    print(f"{question} [y/N] ", end="", file=sys.stderr, flush=True)
    answer = sys.stdin.readline()
    if not answer:
        print(file=sys.stderr)
        return False
    return answer.strip().lower() in {"y", "yes"}


def run_git(args: list[str | Path], *, cwd: Path | None = None) -> None:
    """Run a Git command that should own its normal terminal output."""
    subprocess.run(["git", *args], cwd=cwd, check=True)


def git_output(args: list[str | Path], *, cwd: Path | None = None) -> str | None:
    """Run a quiet Git probe; return None when Git cannot answer it."""
    try:
        return subprocess.check_output(
            ["git", *args], cwd=cwd, encoding="utf-8", stderr=subprocess.DEVNULL
        ).strip()
    except subprocess.CalledProcessError:
        return None


T = TypeVar("T")
U = TypeVar("U")


def parallel_map(fn: Callable[[T], U], items: list[T]) -> list[U]:
    """Map fn over items with a bounded thread pool, preserving order."""
    if len(items) <= 1:
        return [fn(item) for item in items]
    with ThreadPoolExecutor(max_workers=min(8, len(items))) as executor:
        return list(executor.map(fn, items))


# ---------------------------------------------------------------------------
# Remote URL and local name helpers
# ---------------------------------------------------------------------------


SCP_LIKE_URL = re.compile(r"[^@/]+@[^:]+:(.+)$")


class RepoUrl(NamedTuple):
    """A git URL classified once: remote flag, owner segment, repo name."""

    remote: bool
    owner: str | None
    repo: str | None


def parse_repo_url(url: str) -> RepoUrl:
    """Classify a git URL (HTTPS, SSH scp-like, or local path) in one pass."""
    if match := SCP_LIKE_URL.match(url):
        remote, path = True, match.group(1)
    else:
        parsed = urlparse(url)
        remote, path = bool(parsed.scheme), (parsed.path if parsed.scheme else url)
    parts = [part for part in path.rstrip("/").removesuffix(".git").split("/") if part]
    owner = parts[-2] if len(parts) >= 2 else None
    return RepoUrl(remote, owner, parts[-1] if parts else None)


def repo_name_from_url(url: str) -> str:
    """Derive the local repository name: the last path component of the URL."""
    repo = parse_repo_url(url).repo
    if repo is None:
        raise ValueError(f"cannot derive repository name from '{url}'")
    return repo


def suggest_clone_name(url: str, repo_name: str) -> str:
    """Suggest a distinct name for a colliding clone.

    Remote URLs disambiguate by owner (the common case: two owners with the
    same repository name); anything else falls back to a numeric suffix.
    """
    parsed = parse_repo_url(url)
    if parsed.remote and parsed.owner and parsed.owner != repo_name:
        return f"{repo_name}-{parsed.owner}"
    return f"{repo_name}-2"


def validate_path_name(kind: str, name: str) -> None:
    if not VALID_PATH_NAME.fullmatch(name):
        fail(
            f"invalid {kind} name '{name}'; use only letters, numbers, dots, underscores, and dashes"
        )
    if name in {".", ".."} or name.startswith("."):
        fail(f"invalid {kind} name '{name}'")


def origin_url(bare: Path) -> str | None:
    return git_output(["config", "--get", "remote.origin.url"], cwd=bare)


def clone_collision_error(url: str, container: Path, local_name: str) -> None:
    lines = [
        f"local repository name '{local_name}' already exists",
        "",
        "Existing:",
        f"  path:   {container}",
    ]
    if origin := origin_url(container / BARE_DIR):
        lines.append(f"  origin: {origin}")
    lines += [
        "",
        "Requested:",
        f"  origin: {url}",
        "",
        "Use a distinct name, for example:",
        f"  gra clone {url} --name {suggest_clone_name(url, local_name)}",
    ]
    fail("\n".join(lines))


