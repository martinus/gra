def add_local_excludes(bare: Path) -> None:
    """Install ignore rules for tool-managed paths, shared by all worktrees."""
    info = bare / "info"
    exclude = info / "exclude"
    info.mkdir(exist_ok=True)
    lines = exclude.read_text(encoding="utf-8").splitlines() if exclude.is_file() else []
    missing = [pattern for pattern in LOCAL_EXCLUDES if pattern not in lines]
    if missing:
        with exclude.open("a", encoding="utf-8") as file:
            if lines and lines[-1] != "":
                file.write("\n")
            for pattern in missing:
                file.write(f"{pattern}\n")


def write_default_hooks(container: Path) -> int:
    """Drop working work.sh and done.sh hooks in the container, and count them.

    Executable, so a fresh clone opens and closes tmux windows without any
    setup - that behaviour lives in these scripts now, not in gra. Hooks that
    already exist are left alone, edits and all.
    """
    written = 0
    for name, default in ((WORK_HOOK, WORK_HOOK_DEFAULT), (DONE_HOOK, DONE_HOOK_DEFAULT)):
        script = container / name
        if not script.exists():
            script.write_text(default, encoding="utf-8")
            script.chmod(0o755)
            log(f"wrote '{script}'")
            written += 1
    return written


def write_missing_hooks(root: Path) -> None:
    """Give every repository under the root the hooks it is missing.

    Repositories cloned before hooks existed have none, and only 'gra clone'
    writes them, so without this they would stay silent forever.
    """
    repositories = containers(root)
    if not repositories:
        print(f"Root: {root}")
        print("No repositories found.")
        return
    written = sum(write_default_hooks(container) for container in repositories)
    log(
        f"{written} hook(s) written across {len(repositories)} repositories"
        if written
        else f"all {len(repositories)} repositories already have their hooks",
        GREEN,
    )


def clone(
    url: str,
    name: str | None,
    root: Path,
    *,
    no_work: bool,
    no_hook: bool,
    no_submodules: bool,
    no_upstream: bool,
) -> None:
    """Clone into a bare checkout under the gra root, with a worktree on it."""
    try:
        local_name = name or repo_name_from_url(url)
    except ValueError as error:
        fail(str(error))
    validate_path_name("repository", local_name)

    container = root / local_name
    if container.exists():
        clone_collision_error(url, container, local_name)

    bare = bare_dir(container)
    try:
        bare.mkdir(parents=True)
        log(f"Cloning '{url}' into '{container}'")
        run_git(["init", "--quiet", "--bare", bare])
        # `git remote add` installs the standard +refs/heads/*:refs/remotes/origin/*
        # refspec, so the bare repository tracks origin like a normal clone and
        # never mirrors remote branches into local refs/heads.
        run_git(["remote", "add", "origin", url], cwd=bare)
        # Bare repositories disable reflogs by default; keep them for safety.
        run_git(["config", "core.logAllRefUpdates", "true"], cwd=bare)
        run_git(["fetch", "--prune", "origin"], cwd=bare)
        # A remote without commits has no HEAD to resolve. That is not a failed
        # clone, and remote_default_branch falls back to main/master anyway.
        git_output(["remote", "set-head", "origin", "--auto"], cwd=bare)
        if no_submodules:
            run_git(["config", SUBMODULES_CONFIG, "false"], cwd=bare)
        add_local_excludes(bare)
        write_default_hooks(container)
    except Exception:
        if container.exists():
            shutil.rmtree(container)
        raise

    # Past this point the clone itself succeeded, so it is kept whatever
    # happens to the worktree: no cleanup here, and no failure for a remote
    # that has nothing to check out yet.
    if not no_upstream:
        add_upstream_remote(bare, url)

    if no_work:
        log(f"created '{container}'; run 'gra work' inside it to begin working", GREEN)
        return
    log(f"created '{container}'", GREEN)
    ref = remote_default_branch(bare)
    if not ref:
        log(
            f"'{url}' has no default branch yet; "
            "run 'gra work' once it has its first commit",
            YELLOW,
        )
        return
    create_worktree(container, root, ref.removeprefix("origin/"), no_hook=no_hook)


